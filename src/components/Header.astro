---
import { t, getLocalizedPath, getDocPath, getAlternateLocale, getAlternateUrl, routes, type Locale } from '../i18n/utils';
import { isActiveSection } from '../lib/chrome-helpers';
import BellIcon from './BellIcon.astro';
import MegaMenu from './MegaMenu.astro';
import MobileBottomBar from './MobileBottomBar.astro';
import MobileDrawer from './MobileDrawer.astro';
import SyncPill from './SyncPill.astro';

interface Props {
  lang: string;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;
const tr = t(lang);
const trEn = t('en');
const trEs = t('es');
const alt = getAlternateLocale(lang);
const locale = (lang === 'es' ? 'es' : 'en') as Locale;

const altHref = getAlternateUrl(currentPath, alt);

// Active-state precomputes for the verbs
const obsActive  = isActiveSection(currentPath, 'observe',  lang);
const expActive  = isActiveSection(currentPath, 'explore',  lang);
const chatActive = isActiveSection(currentPath, 'chat',     lang);
const docsActive = isActiveSection(currentPath, 'docs',     lang);
const aboutActive = isActiveSection(currentPath, 'about',   lang);

// Section accent — emerald is the default (the brand). Per spec §7,
// Explore = teal-500, Chat = sky-500, Docs/About = stone-500. The active
// rail picks the right token. PR 1 wires the rail; refinement is in PR 5.
const railClass = (active: boolean, accent: 'emerald' | 'teal' | 'sky' | 'stone') => active
  ? `text-${accent}-600 dark:text-${accent}-400 after:bg-${accent}-500 after:scale-x-100`
  : 'text-zinc-700 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 after:scale-x-0';

// Safelist note: the dynamic section-accent class strings (`text-teal-600`,
// `after:bg-sky-500`, etc.) must be kept reachable for Tailwind. The
// safelist is wired in `tailwind.config.mjs`; if a build emits unstyled
// rails, check that file.

const explorePath       = getLocalizedPath(lang, routes.explore[locale] + '/');
const inboxPath         = getLocalizedPath(lang, routes.inbox[locale] + '/');
const profileExportPath = getLocalizedPath(lang, routes.profileExport[locale] + '/');
const profileDexPath    = getLocalizedPath(lang, routes.dex[locale] + '/');
const profileImportPath = getLocalizedPath(lang, routes.profileImport[locale] + '/');
const exploreMapPath = getLocalizedPath(lang, routes.exploreMap[locale] + '/');
const exploreRecentPath = getLocalizedPath(lang, routes.exploreRecent[locale] + '/');
const exploreWatchlistPath = getLocalizedPath(lang, routes.exploreWatchlist[locale] + '/');
const exploreSpeciesPath = getLocalizedPath(lang, routes.exploreSpecies[locale] + '/');
const exploreValidatePath = getLocalizedPath(lang, routes.exploreValidate[locale] + '/');
const projectsPath = getLocalizedPath(lang, routes.projects[locale] + '/');

// Community discovery (M28) — preset-filtered links into /community/observers/.
const communityObserversBase = getLocalizedPath(lang, routes.communityObservers[locale] + '/');
const communityObserversTopHref     = `${communityObserversBase}?sort=obs_count_30d`;
const communityObserversNearbyHref  = `${communityObserversBase}?nearby=true`;
const communityObserversExpertsHref = `${communityObserversBase}?expert=true`;
const communityObserversCountryHref = `${communityObserversBase}?country=`;
const communityMapHref = getLocalizedPath(lang, routes.communityMap[locale] + '/');
const communityLeaderboardHref = getLocalizedPath(lang, routes.leaderboard[locale] + '/');

const communityDonatePath = getLocalizedPath(lang, routes.communityDonate[locale] + '/');

const validateLabel =
  ((tr as unknown as { validation?: { nav_validate_label?: string } }).validation?.nav_validate_label) ?? 'Validate';
const validateLabelEn =
  ((trEn as unknown as { validation?: { nav_validate_label?: string } }).validation?.nav_validate_label) ?? 'Validate';
const validateLabelEs =
  ((trEs as unknown as { validation?: { nav_validate_label?: string } }).validation?.nav_validate_label) ?? 'Validar';

interface ExploreMegaMenu {
  biodiversity: string;
  community: string;
  community_all: string;
  community_top: string;
  community_nearby: string;
  community_experts: string;
  community_country: string;
  community_map: string;
  community_leaderboard?: string;
  projects?: string;
}
const em = (tr as unknown as { nav: { explore_megamenu: ExploreMegaMenu } }).nav.explore_megamenu;
const emEn = (trEn as unknown as { nav: { explore_megamenu: ExploreMegaMenu } }).nav.explore_megamenu;
const emEs = (trEs as unknown as { nav: { explore_megamenu: ExploreMegaMenu } }).nav.explore_megamenu;

const exploreColumns = [
  {
    heading: em.biodiversity,
    headingEn: emEn.biodiversity,
    headingEs: emEs.biodiversity,
    items: [
      { key: 'exploreMap',       label: tr.nav.explore_dropdown.map,       labelEn: trEn.nav.explore_dropdown.map,       labelEs: trEs.nav.explore_dropdown.map,       href: exploreMapPath, hrefEn: getLocalizedPath('en', routes.exploreMap.en + '/'), hrefEs: getLocalizedPath('es', routes.exploreMap.es + '/') },
      { key: 'exploreRecent',    label: tr.nav.explore_dropdown.recent,    labelEn: trEn.nav.explore_dropdown.recent,    labelEs: trEs.nav.explore_dropdown.recent,    href: exploreRecentPath, hrefEn: getLocalizedPath('en', routes.exploreRecent.en + '/'), hrefEs: getLocalizedPath('es', routes.exploreRecent.es + '/') },
      { key: 'exploreWatchlist', label: tr.nav.explore_dropdown.watchlist, labelEn: trEn.nav.explore_dropdown.watchlist, labelEs: trEs.nav.explore_dropdown.watchlist, href: exploreWatchlistPath, hrefEn: getLocalizedPath('en', routes.exploreWatchlist.en + '/'), hrefEs: getLocalizedPath('es', routes.exploreWatchlist.es + '/') },
      { key: 'exploreSpecies',   label: tr.nav.explore_dropdown.species,   labelEn: trEn.nav.explore_dropdown.species,   labelEs: trEs.nav.explore_dropdown.species,   href: exploreSpeciesPath, hrefEn: getLocalizedPath('en', routes.exploreSpecies.en + '/'), hrefEs: getLocalizedPath('es', routes.exploreSpecies.es + '/') },
      { key: 'exploreValidate',  label: validateLabel,                     labelEn: validateLabelEn,                     labelEs: validateLabelEs,                     href: exploreValidatePath, hrefEn: getLocalizedPath('en', routes.exploreValidate.en + '/'), hrefEs: getLocalizedPath('es', routes.exploreValidate.es + '/') },
      { key: 'projects',         label: em.projects ?? (lang === 'es' ? 'Proyectos' : 'Projects'), labelEn: emEn.projects ?? 'Projects', labelEs: emEs.projects ?? 'Proyectos', href: projectsPath, hrefEn: getLocalizedPath('en', routes.projects.en + '/'), hrefEs: getLocalizedPath('es', routes.projects.es + '/') },
    ],
  },
  {
    heading: em.community,
    headingEn: emEn.community,
    headingEs: emEs.community,
    items: [
      { key: 'communityAll',     label: em.community_all,     labelEn: emEn.community_all,     labelEs: emEs.community_all,     href: communityObserversBase, hrefEn: getLocalizedPath('en', routes.communityObservers.en + '/'), hrefEs: getLocalizedPath('es', routes.communityObservers.es + '/') },
      { key: 'communityTop',     label: em.community_top,     labelEn: emEn.community_top,     labelEs: emEs.community_top,     href: communityObserversTopHref, hrefEn: `${getLocalizedPath('en', routes.communityObservers.en + '/')}?sort=obs_count_30d`, hrefEs: `${getLocalizedPath('es', routes.communityObservers.es + '/')}?sort=obs_count_30d` },
      { key: 'communityNearby',  label: em.community_nearby,  labelEn: emEn.community_nearby,  labelEs: emEs.community_nearby,  href: communityObserversNearbyHref, hrefEn: `${getLocalizedPath('en', routes.communityObservers.en + '/')}?nearby=true`, hrefEs: `${getLocalizedPath('es', routes.communityObservers.es + '/')}?nearby=true` },
      { key: 'communityExperts', label: em.community_experts, labelEn: emEn.community_experts, labelEs: emEs.community_experts, href: communityObserversExpertsHref, hrefEn: `${getLocalizedPath('en', routes.communityObservers.en + '/')}?expert=true`, hrefEs: `${getLocalizedPath('es', routes.communityObservers.es + '/')}?expert=true` },
      { key: 'communityCountry', label: em.community_country, labelEn: emEn.community_country, labelEs: emEs.community_country, href: communityObserversCountryHref, hrefEn: `${getLocalizedPath('en', routes.communityObservers.en + '/')}?country=`, hrefEs: `${getLocalizedPath('es', routes.communityObservers.es + '/')}?country=` },
      { key: 'communityMap',     label: em.community_map,     labelEn: emEn.community_map,     labelEs: emEs.community_map,     href: communityMapHref, hrefEn: getLocalizedPath('en', routes.communityMap.en + '/'), hrefEs: getLocalizedPath('es', routes.communityMap.es + '/') },
      { key: 'leaderboard',     label: em.community_leaderboard ?? (lang === 'es' ? 'Tabla de líderes' : 'Leaderboard'), labelEn: emEn.community_leaderboard ?? 'Leaderboard', labelEs: emEs.community_leaderboard ?? 'Tabla de líderes', href: communityLeaderboardHref, hrefEn: getLocalizedPath('en', routes.leaderboard.en + '/'), hrefEs: getLocalizedPath('es', routes.leaderboard.es + '/') },
    ],
  },
];

const docColumns = [
  {
    heading: tr.nav.docs_groups.product,
    headingEn: trEn.nav.docs_groups.product,
    headingEs: trEs.nav.docs_groups.product,
    items: [
      { key: 'vision',       label: tr.nav.docs_groups.product_items.vision,       labelEn: trEn.nav.docs_groups.product_items.vision,       labelEs: trEs.nav.docs_groups.product_items.vision,       hrefEn: getDocPath('en', 'vision'),       hrefEs: getDocPath('es', 'vision') },
      { key: 'features',     label: tr.nav.docs_groups.product_items.features,     labelEn: trEn.nav.docs_groups.product_items.features,     labelEs: trEs.nav.docs_groups.product_items.features,     hrefEn: getDocPath('en', 'features'),     hrefEs: getDocPath('es', 'features') },
      { key: 'architecture', label: tr.nav.docs_groups.product_items.architecture, labelEn: trEn.nav.docs_groups.product_items.architecture, labelEs: trEs.nav.docs_groups.product_items.architecture, hrefEn: getDocPath('en', 'architecture'), hrefEs: getDocPath('es', 'architecture') },
      { key: 'mcp',          label: tr.nav.docs_groups.product_items.mcp,          labelEn: trEn.nav.docs_groups.product_items.mcp,          labelEs: trEs.nav.docs_groups.product_items.mcp,          hrefEn: getDocPath('en', 'mcp'),          hrefEs: getDocPath('es', 'mcp') },
    ],
  },
  {
    heading: tr.nav.docs_groups.progress,
    headingEn: trEn.nav.docs_groups.progress,
    headingEs: trEs.nav.docs_groups.progress,
    items: [
      { key: 'roadmap', label: tr.nav.docs_groups.progress_items.roadmap, labelEn: trEn.nav.docs_groups.progress_items.roadmap, labelEs: trEs.nav.docs_groups.progress_items.roadmap, hrefEn: getDocPath('en', 'roadmap'), hrefEs: getDocPath('es', 'roadmap') },
      { key: 'tasks',   label: tr.nav.docs_groups.progress_items.tasks,   labelEn: trEn.nav.docs_groups.progress_items.tasks,   labelEs: trEs.nav.docs_groups.progress_items.tasks,   hrefEn: getDocPath('en', 'tasks'),   hrefEs: getDocPath('es', 'tasks') },
      { key: 'market',  label: tr.nav.docs_groups.progress_items.market,  labelEn: trEn.nav.docs_groups.progress_items.market,  labelEs: trEs.nav.docs_groups.progress_items.market,  hrefEn: getDocPath('en', 'market'),  hrefEs: getDocPath('es', 'market') },
    ],
  },
  {
    heading: tr.nav.docs_groups.community,
    headingEn: trEn.nav.docs_groups.community,
    headingEs: trEs.nav.docs_groups.community,
    items: [
      { key: 'contribute',    label: tr.nav.docs_groups.community_items.contribute,   labelEn: trEn.nav.docs_groups.community_items.contribute,   labelEs: trEs.nav.docs_groups.community_items.contribute,   hrefEn: getDocPath('en', 'contribute'),   hrefEs: getDocPath('es', 'contribute') },
      { key: 'sponsorships',  label: tr.nav.docs_groups.community_items.sponsorships, labelEn: trEn.nav.docs_groups.community_items.sponsorships, labelEs: trEs.nav.docs_groups.community_items.sponsorships, hrefEn: getDocPath('en', 'sponsorships'), hrefEs: getDocPath('es', 'sponsorships') },
    ],
  },
];
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-4">
    <!-- Lockup -->
    <a href={getLocalizedPath(lang, '/')}
       data-href-en={getLocalizedPath('en', '/')}
       data-href-es={getLocalizedPath('es', '/')}
       class="flex flex-col leading-tight">
      <span class="flex items-center gap-2 text-lg font-bold text-emerald-600 dark:text-emerald-400">
        <img src="/com-logo.jpg" alt="COM Logo" class="w-8 h-8 rounded-full object-cover" width="32" height="32" />
        COM Argentina
      </span>
      <span class="hidden md:block text-[11px] text-zinc-600 dark:text-zinc-400 -mt-0.5 ml-10"
            data-i18n
            data-en={trEn.nav.tagline}
            data-es={trEs.nav.tagline}>
        {tr.nav.tagline}
      </span>
    </a>

    <span class="hidden sm:block w-px h-6 bg-zinc-200 dark:bg-zinc-800"></span>

    <!-- Verbs (left) -->
    <nav class="hidden sm:flex items-center gap-5 text-sm min-w-0">
      <a href={getLocalizedPath(lang, routes.observe[locale] + '/')}
         data-tour="observe-nav"
         data-href-en={getLocalizedPath('en', routes.observe.en + '/')}
         data-href-es={getLocalizedPath('es', routes.observe.es + '/')}
         class:list={[
           'relative pb-1 transition-colors after:content-[""] after:absolute after:left-0 after:right-0 after:-bottom-3 after:h-[2px] after:rounded after:transition-transform after:origin-left',
           railClass(obsActive, 'emerald'),
         ]}>
        <span data-i18n data-en={trEn.nav.observe} data-es={trEs.nav.observe}>{tr.nav.observe}</span>
      </a>

      <!-- Explore mega-menu — Biodiversity + Community columns (M28) -->
      <MegaMenu
        lang={locale}
        trigger={tr.nav.explore}
        triggerEn={trEn.nav.explore}
        triggerEs={trEs.nav.explore}
        columns={exploreColumns}
        align="left"
        active={expActive}
        accent="teal"
        cols={2}
        dataTour="explore-nav"
      />

      <a href={getLocalizedPath(lang, routes.chat[locale] + '/')}
         data-href-en={getLocalizedPath('en', routes.chat.en + '/')}
         data-href-es={getLocalizedPath('es', routes.chat.es + '/')}
         class:list={[
           'relative pb-1 transition-colors after:content-[""] after:absolute after:left-0 after:right-0 after:-bottom-3 after:h-[2px] after:rounded after:transition-transform after:origin-left',
           railClass(chatActive, 'sky'),
         ]}>
        <span data-i18n data-en={trEn.nav.chat} data-es={trEs.nav.chat}>{tr.nav.chat}</span>
      </a>
    </nav>

    <!-- Reference (right of verbs, before auth) -->
    <nav class="hidden lg:flex items-center gap-5 text-sm ml-auto">
      <a href={getLocalizedPath(lang, routes.about[locale] + '/')}
         data-href-en={getLocalizedPath('en', routes.about.en + '/')}
         data-href-es={getLocalizedPath('es', routes.about.es + '/')}
         class:list={[
           'relative pb-1 transition-colors after:content-[""] after:absolute after:left-0 after:right-0 after:-bottom-3 after:h-[2px] after:rounded after:transition-transform after:origin-left',
           railClass(aboutActive, 'stone'),
         ]}>
        <span data-i18n data-en={trEn.nav.about} data-es={trEs.nav.about}>{tr.nav.about}</span>
      </a>
      <MegaMenu
        lang={locale}
        trigger={tr.nav.docs}
        triggerEn={trEn.nav.docs}
        triggerEs={trEs.nav.docs}
        columns={docColumns}
        align="right"
        active={docsActive}
      />
      <!-- Search trigger (⌕) — desktop only; dispatches rastrum:open-palette -->
      <button
        id="hdr-search-btn"
        type="button"
        aria-label={tr.search.toast_open}
        class="p-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </button>
    </nav>

    <!-- Auth + utilities — ml-auto on mobile pushes to the right edge since the reference nav (which carries ml-auto on desktop) is hidden under sm: -->
    <div class="flex items-center gap-2 ml-auto sm:ml-2 shrink-0">
      <!-- Search trigger (⌕) — mobile only (desktop version lives in the reference nav above) -->
      <button
        id="hdr-search-btn-mobile"
        type="button"
        aria-label={tr.search.toast_open}
        class="sm:hidden p-2 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
      </button>
      <a
        href={getLocalizedPath(lang, routes.signIn[locale] + '/')}
        id="sign-in-link"
        data-href-en={getLocalizedPath('en', routes.signIn.en + '/')}
        data-href-es={getLocalizedPath('es', routes.signIn.es + '/')}
        class="hidden text-xs font-medium px-2.5 py-1 rounded border border-emerald-600/60 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-colors"
      >
        <span data-i18n data-en={trEn.auth.sign_in} data-es={trEs.auth.sign_in}>{tr.auth.sign_in}</span>
      </a>
      <SyncPill lang={locale} />
      <BellIcon lang={locale} />
      <div id="avatar-wrap" class="hidden relative shrink-0">
        <button id="avatar-btn" data-tour="avatar-btn" aria-label="Account menu" class="block rounded-full focus:outline-none focus:ring-2 focus:ring-emerald-500">
          <span
            id="header-avatar-frame"
            class="inline-block rounded-full ring-offset-2 ring-offset-white dark:ring-offset-zinc-900"
            data-karma-frame
            data-karma-tier="seedling"
            data-karma-glow="0"
          >
            <img id="header-avatar" src="" alt="" class="w-8 h-8 rounded-full bg-emerald-600 object-cover" />
          </span>
        </button>
        <div id="avatar-menu" class="hidden absolute right-0 top-full mt-2 w-52 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-lg py-1 z-50">
          <a id="menu-profile" href={getLocalizedPath(lang, routes.profile[locale] + '/')} data-href-en={getLocalizedPath('en', routes.profile.en + '/')} data-href-es={getLocalizedPath('es', routes.profile.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={trEn.profile.view_profile} data-es={trEs.profile.view_profile}>{tr.profile.view_profile}</a>
          <a id="menu-observations" href={getLocalizedPath(lang, routes.profileObservations[locale] + '/')} data-href-en={getLocalizedPath('en', routes.profileObservations.en + '/')} data-href-es={getLocalizedPath('es', routes.profileObservations.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={trEn.profile.my_observations_title} data-es={trEs.profile.my_observations_title}>{tr.profile.my_observations_title}</a>
          <a id="menu-watchlist" href={getLocalizedPath(lang, routes.exploreWatchlist[locale] + '/')} data-href-en={getLocalizedPath('en', routes.exploreWatchlist.en + '/')} data-href-es={getLocalizedPath('es', routes.exploreWatchlist.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={trEn.nav.explore_dropdown.watchlist} data-es={trEs.nav.explore_dropdown.watchlist}>{tr.nav.explore_dropdown.watchlist}</a>
          <a id="menu-inbox" href={inboxPath} data-href-en={getLocalizedPath('en', routes.inbox.en + '/')} data-href-es={getLocalizedPath('es', routes.inbox.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={(trEn as unknown as { socialgraph: { inbox: { title: string } } }).socialgraph.inbox.title} data-es={(trEs as unknown as { socialgraph: { inbox: { title: string } } }).socialgraph.inbox.title}>{(tr as unknown as { socialgraph: { inbox: { title: string } } }).socialgraph.inbox.title}</a>
          <a id="menu-dex" href={profileDexPath} data-href-en={getLocalizedPath('en', routes.dex.en + '/')} data-href-es={getLocalizedPath('es', routes.dex.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={(trEn as unknown as { pokedex: { title: string } }).pokedex.title} data-es={(trEs as unknown as { pokedex: { title: string } }).pokedex.title}>{(tr as unknown as { pokedex: { title: string } }).pokedex.title}</a>
          <a id="menu-export" href={profileExportPath} data-href-en={getLocalizedPath('en', routes.profileExport.en + '/')} data-href-es={getLocalizedPath('es', routes.profileExport.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={trEn.profile.export} data-es={trEs.profile.export}>{tr.profile.export}</a>
          <a id="menu-import" href={profileImportPath} data-href-en={getLocalizedPath('en', routes.profileImport.en + '/')} data-href-es={getLocalizedPath('es', routes.profileImport.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={(trEn as unknown as { import: { title: string } }).import.title} data-es={(trEs as unknown as { import: { title: string } }).import.title}>{(tr as unknown as { import: { title: string } }).import.title}</a>
          <a id="menu-settings" href={getLocalizedPath(lang, routes.profileSettings[locale] + '/profile/')} data-href-en={getLocalizedPath('en', routes.profileSettings.en + '/profile/')} data-href-es={getLocalizedPath('es', routes.profileSettings.es + '/profile/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={`${trEn.profile.settings_link} ▸`} data-es={`${trEs.profile.settings_link} ▸`}>{tr.profile.settings_link} ▸</a>
          <a id="menu-sponsoring" href={getLocalizedPath(lang, routes.sponsoring[locale] + '/')} data-href-en={getLocalizedPath('en', routes.sponsoring.en + '/')} data-href-es={getLocalizedPath('es', routes.sponsoring.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={trEn.sponsoring.page_title} data-es={trEs.sponsoring.page_title}>{tr.sponsoring.page_title}</a>
          <a id="menu-sponsored-by" href={getLocalizedPath(lang, routes.sponsoredBy[locale] + '/')} data-href-en={getLocalizedPath('en', routes.sponsoredBy.en + '/')} data-href-es={getLocalizedPath('es', routes.sponsoredBy.es + '/')} class="block px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800" data-i18n data-en={trEn.sponsoring.quota_nav_label} data-es={trEs.sponsoring.quota_nav_label}>{tr.sponsoring.quota_nav_label}</a>
          <div class="border-t border-zinc-200 dark:border-zinc-800 my-1"></div>
