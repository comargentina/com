      <a
        href={altHref}
        id="lang-toggle"
        data-target-lang={alt}
        class="hidden md:block text-xs font-medium px-2 py-1 rounded border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
      >
        {alt.toUpperCase()}
