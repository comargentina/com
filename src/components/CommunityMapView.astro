---
/**
 * CommunityMapView — aggregated heatmap of observer activity.
 *
 * Privacy invariant: minimum 1 observer per hex cell to render.
 * Anonymous users see data from `community_observers` (no centroid).
 * Authenticated users get centroid data from `community_observers_with_centroid`.
 * Individual centroids are never exposed — only aggregated hex cells.
 */
import { t, getLocalizedPath, routes } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
const tr = t(lang);

interface CommunityMapCopy {
  map_title: string;
  map_subtitle: string;
  map_observers_in_view: string;
  map_min_cluster: string;
  map_sign_in_hint: string;
  map_loading: string;
  map_no_data: string;
  cross_link: {
    prompt: string;
    cta: string;
  };
  filter: Record<string, string>;
  expert_pill: string;
  sort: Record<string, string>;
}
const cm = (tr as unknown as { community: CommunityMapCopy }).community;

const locale = lang === 'es' ? 'es' : 'en';
const observationsMapHref = getLocalizedPath(lang, routes.exploreMap[locale] + '/');

const stringsJson = JSON.stringify({
  lang,
  mapTitle: cm.map_title,
  mapSubtitle: cm.map_subtitle,
  observersInView: cm.map_observers_in_view,
  minCluster: cm.map_min_cluster,
  signInHint: cm.map_sign_in_hint,
  loading: cm.map_loading,
  noData: cm.map_no_data,
  filterCountry: cm.filter.country,
  filterAny: cm.filter.any,
  filterExpertsOnly: cm.filter.experts_only,
  sortObs: cm.sort.obs,
  sortSpecies: cm.sort.species,
  sortActive7d: cm.sort.active_7d,
  sortActive30d: cm.sort.active_30d,
  expertPill: cm.expert_pill,
});
---

<section
  id="community-map-root"
  class="flex flex-col h-[calc(100vh-4rem)]"
  data-strings={stringsJson}
>
  <div class="px-4 py-3 border-b border-zinc-200 dark:border-zinc-800">
    <div class="flex items-start justify-between gap-4 flex-wrap max-w-5xl mx-auto">
      <div class="min-w-0">
        <h1 class="text-xl font-bold tracking-tight">{cm.map_title}</h1>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mb-3">
          {cm.cross_link.prompt}{' '}
          <a href={observationsMapHref} class="text-emerald-600 dark:text-emerald-400 hover:underline">
            {cm.cross_link.cta}
          </a>
        </p>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-0.5">{cm.map_subtitle}</p>
      </div>
      <span
        id="cm-observer-count"
        class="hidden text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300 whitespace-nowrap"
        aria-live="polite"
      ></span>
    </div>
  </div>

  <div
    id="cm-chips"
    class="px-4 py-2 border-b border-zinc-200 dark:border-zinc-800 flex flex-wrap gap-2 items-center max-w-5xl mx-auto w-full"
  >
    <select
      id="cm-sort"
      aria-label={cm.sort.obs}
      class="text-sm rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-2 py-1"
    >
      <option value="observation_count">{cm.sort.obs}</option>
      <option value="species_count">{cm.sort.species}</option>
      <option value="obs_count_7d">{cm.sort.active_7d}</option>
      <option value="obs_count_30d">{cm.sort.active_30d}</option>
    </select>
    <select
      id="cm-country"
      aria-label={cm.filter.country}
      class="text-sm rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-2 py-1"
    >
      <option value="">{cm.filter.country}: {cm.filter.any}</option>
    </select>
    <label class="text-sm flex items-center gap-1.5">
      <input id="cm-experts" type="checkbox" />
      {cm.filter.experts_only}
    </label>
  </div>

  <div id="cm-map-container" class="flex-1 relative bg-zinc-100 dark:bg-zinc-900">
    <p id="cm-loading" class="absolute inset-0 flex items-center justify-center text-sm text-zinc-600 dark:text-zinc-300 italic">
      {cm.map_loading}
    </p>
    <p id="cm-no-data" class="hidden absolute inset-0 flex items-center justify-center text-sm text-zinc-600 dark:text-zinc-300">
      {cm.map_no_data}
    </p>
    <p id="cm-sign-in-hint" class="hidden absolute bottom-4 left-4 right-4 text-center text-xs text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 rounded-lg px-3 py-2 z-10">
      {cm.map_sign_in_hint}
    </p>
    <p id="cm-privacy-note" class="hidden absolute bottom-4 left-4 right-4 text-center text-xs text-zinc-600 dark:text-zinc-400 bg-white/90 dark:bg-zinc-900/90 border border-zinc-200 dark:border-zinc-800 rounded-lg px-3 py-2 z-10">
      {cm.map_min_cluster}
    </p>
  </div>
</section>

<!-- PBI 5.4 — defer MapLibre CSS off the critical path; see MapPicker.astro. -->
<link
  rel="stylesheet"
  href="https://unpkg.com/maplibre-gl@4.7.0/dist/maplibre-gl.css"
  media="print"
  onload="this.media='all'; this.onload=null;"
/>
<noscript><link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.0/dist/maplibre-gl.css" /></noscript>

<script>
  import { getCachedUser, getSupabase } from '../lib/supabase';
  import { loadIsoCountries } from '../lib/community';
  import { basemapStyleUrl, installSpriteFallback } from '../lib/map-style';

  interface Strings {
    lang: 'en' | 'es';
    mapTitle: string;
    mapSubtitle: string;
    observersInView: string;
    minCluster: string;
    signInHint: string;
    loading: string;
    noData: string;
    filterCountry: string;
    filterAny: string;
    filterExpertsOnly: string;
    sortObs: string;
    sortSpecies: string;
    sortActive7d: string;
    sortActive30d: string;
    expertPill: string;
  }

  interface ObserverRow {
    id: string;
    username: string | null;
    display_name: string | null;
    avatar_url: string | null;
    country_code: string | null;
    is_expert: boolean;
    observation_count: number;
    species_count: number;
    obs_count_7d: number;
    obs_count_30d: number;
    centroid_lat?: number | null;
    centroid_lng?: number | null;
  }

  // H3-like hex cell key at ~0.5° resolution for privacy aggregation.
  // Rounds lat/lng to 0.5° grid cells — coarse enough to protect
  // individual locations while showing meaningful density patterns.
  function hexKey(lat: number, lng: number): string {
    const rLat = (Math.round(lat * 2) / 2).toFixed(1);
    const rLng = (Math.round(lng * 2) / 2).toFixed(1);
    return `${rLat},${rLng}`;
  }

  function hexCenter(key: string): [number, number] {
    const [lat, lng] = key.split(',').map(Number);
    return [lng, lat];
  }

  const MIN_OBSERVERS_PER_CELL = 1;

  // Fallback country centers used when a user has no personal centroid yet.
  // Coordinates are approximate geographic centers of each country.
  const COUNTRY_CENTERS: Record<string, [number, number]> = {
    AR: [-34.6, -63.6],
    BR: [-14.2, -51.9],
    CL: [-35.7, -71.5],
    UY: [-32.5, -55.8],
    PY: [-23.4, -58.4],
    BO: [-16.3, -63.6],
    PE: [-9.2, -75.0],
    EC: [-1.8, -78.2],
    CO: [4.6, -74.3],
    VE: [8.0, -66.6],
    MX: [23.6, -102.5],
    GT: [15.8, -90.2],
    HN: [15.2, -86.2],
    SV: [13.8, -88.9],
    NI: [12.9, -85.2],
    CR: [9.7, -83.8],
    PA: [8.5, -80.8],
    CU: [22.0, -80.0],
    DO: [18.7, -70.2],
    US: [37.1, -95.7],
    ES: [40.5, -3.7],
  };

  const root = document.getElementById('community-map-root');
  if (!root) throw new Error('CommunityMapView: missing #community-map-root');
  const STRINGS: Strings = JSON.parse(root.dataset.strings ?? '{}');

  const mapContainer = document.getElementById('cm-map-container');
  const loadingEl = document.getElementById('cm-loading');
  const noDataEl = document.getElementById('cm-no-data');
  const signInHintEl = document.getElementById('cm-sign-in-hint');
  const privacyNoteEl = document.getElementById('cm-privacy-note');
  const countBadge = document.getElementById('cm-observer-count');
  const sortEl = document.getElementById('cm-sort') as HTMLSelectElement | null;
  const countryEl = document.getElementById('cm-country') as HTMLSelectElement | null;
  const expertsEl = document.getElementById('cm-experts') as HTMLInputElement | null;

  if (!mapContainer || !loadingEl || !noDataEl || !signInHintEl ||
      !privacyNoteEl || !countBadge || !sortEl || !countryEl || !expertsEl) {
    throw new Error('CommunityMapView: missing required DOM nodes');
  }

  // Populate country dropdown
  void (async () => {
    try {
      const countries = await loadIsoCountries(STRINGS.lang);
      for (const c of countries) {
        const opt = document.createElement('option');
        opt.value = c.code;
        opt.textContent = c.name;
        countryEl.appendChild(opt);
      }
    } catch {
      // non-fatal
    }
  })();

  type MapLibreMap = import('maplibre-gl').Map;
  let map: MapLibreMap | null = null;
  let allRows: ObserverRow[] = [];
  let isAuthenticated = false;

  async function fetchObservers(): Promise<ObserverRow[]> {
    const supabase = getSupabase();

    // Check auth status
    try {
      const user = await getCachedUser();
      isAuthenticated = !!user;
    } catch {
      isAuthenticated = false;
    }

    // Authenticated users get centroid data for the heatmap.
    // Anonymous users get country_code only (no centroid).
    if (isAuthenticated) {
      const { data, error } = await supabase
        .from('community_observers_with_centroid')
        .select('id, username, display_name, avatar_url, country_code, is_expert, observation_count, species_count, obs_count_7d, obs_count_30d, centroid_lat, centroid_lng');
      if (error) throw error;
      return (data ?? []) as ObserverRow[];
    }

    // Anon: no centroid, just country-level data
    const { data, error } = await supabase
      .from('community_observers')
      .select('id, username, display_name, avatar_url, country_code, is_expert, observation_count, species_count, obs_count_7d, obs_count_30d');
    if (error) throw error;
    return (data ?? []) as ObserverRow[];
  }

  function filterRows(rows: ObserverRow[]): ObserverRow[] {
    let filtered = rows;
    const country = countryEl.value;
    if (country) filtered = filtered.filter(r => r.country_code === country);
    if (expertsEl.checked) filtered = filtered.filter(r => r.is_expert);
    return filtered;
  }


  interface UserSummary {
    username: string | null;
    display_name: string | null;
    avatar_url: string | null;
    observation_count: number;
    is_expert: boolean;
  }

  interface HexCell {
    key: string;
    center: [number, number]; // [lng, lat]
    count: number;
    weight: number;
    users: UserSummary[];
  }

  function aggregateToHex(rows: ObserverRow[], sortField: string): HexCell[] {
    const cells = new Map<string, { count: number; weight: number; users: UserSummary[] }>();

    for (const row of rows) {
      let lat = row.centroid_lat;
      let lng = row.centroid_lng;

      // Fallback to country center when personal centroid is not yet computed.
      if (lat == null || lng == null || !Number.isFinite(lat) || !Number.isFinite(lng)) {
        const cc = row.country_code?.toUpperCase();
        const fallback = cc ? COUNTRY_CENTERS[cc] : COUNTRY_CENTERS['AR'];
        [lat, lng] = fallback;
      }

      const key = hexKey(lat, lng);
      const existing = cells.get(key) ?? { count: 0, weight: 0, users: [] };
      existing.count += 1;

      // Weight by the selected sort metric
      let w = row.observation_count;
      if (sortField === 'species_count') w = row.species_count;
      else if (sortField === 'obs_count_7d') w = row.obs_count_7d;
      else if (sortField === 'obs_count_30d') w = row.obs_count_30d;
      existing.weight += w;

      // Keep up to 5 user summaries per cell for popup display
      if (existing.users.length < 5) {
        existing.users.push({
          username: row.username,
          display_name: row.display_name,
          avatar_url: row.avatar_url,
          observation_count: row.observation_count,
          is_expert: row.is_expert,
        });
      }

      cells.set(key, existing);
    }

    // Only include cells with >= MIN_OBSERVERS_PER_CELL
    const result: HexCell[] = [];
    for (const [key, cell] of cells) {
      if (cell.count >= MIN_OBSERVERS_PER_CELL) {
        result.push({
          key,
          center: hexCenter(key),
          count: cell.count,
          weight: cell.weight,
          users: cell.users,
        });
      }
    }
    return result;
  }

  function buildGeoJSON(cells: HexCell[]): GeoJSON.FeatureCollection {
    return {
      type: 'FeatureCollection',
      features: cells.map(cell => ({
        type: 'Feature',
        geometry: {
          type: 'Point',
          coordinates: cell.center,
        },
        properties: {
          count: cell.count,
          weight: cell.weight,
          users: JSON.stringify(cell.users),
        },
      })),
    };
  }

  function updateCountBadge(count: number) {
    countBadge.textContent = STRINGS.observersInView.replace('{count}', String(count));
    countBadge.classList.toggle('hidden', count === 0);
  }


  async function renderMap() {
    loadingEl.classList.remove('hidden');
    noDataEl.classList.add('hidden');
    signInHintEl.classList.add('hidden');
    privacyNoteEl.classList.add('hidden');

    try {
      if (allRows.length === 0) {
        allRows = await fetchObservers();
      }

      const filtered = filterRows(allRows);
      const cells = aggregateToHex(filtered, sortEl.value);
      updateCountBadge(filtered.length);

      if (filtered.length === 0) {
        loadingEl.classList.add('hidden');
        noDataEl.classList.remove('hidden');
        return;
      }

      if (!isAuthenticated) {
        signInHintEl.classList.remove('hidden');
      }

      if (!map) {
        const maplibre = (await import('maplibre-gl')).default;
        const { COLON_DEFAULT_CENTER } = await import('../lib/media-helpers');
        map = new maplibre.Map({
          container: mapContainer,
          style: basemapStyleUrl(),
          center: [COLON_DEFAULT_CENTER.lng, COLON_DEFAULT_CENTER.lat],
          zoom: COLON_DEFAULT_CENTER.zoom - 2,
          attributionControl: { compact: true },
        });
        map.addControl(new maplibre.NavigationControl({ showCompass: false }), 'top-right');
        installSpriteFallback(map);

        await new Promise<void>((resolve) => {
          map!.on('load', () => resolve());
        });
      }

      loadingEl.classList.add('hidden');

      // aggregateToHex falls back to country center when personal centroid is absent,
      // so always attempt to render the heatmap.
      const geojson = buildGeoJSON(cells);

      const src = map.getSource('observers') as import('maplibre-gl').GeoJSONSource | undefined;
      if (src) {
        src.setData(geojson);
      } else {
        map.addSource('observers', {
          type: 'geojson',
          data: geojson,
        });

        // Heatmap layer
        map.addLayer({
          id: 'observers-heat',
          type: 'heatmap',
          source: 'observers',
          paint: {
            'heatmap-weight': [
              'interpolate', ['linear'], ['get', 'weight'],
              0, 0,
              100, 1,
            ],
            'heatmap-intensity': [
              'interpolate', ['linear'], ['zoom'],
              0, 0.5,
              9, 2,
            ],
            'heatmap-color': [
              'interpolate', ['linear'], ['heatmap-density'],
              0, 'rgba(16,185,129,0)',
              0.2, 'rgba(16,185,129,0.4)',
              0.4, 'rgba(52,211,153,0.6)',
              0.6, 'rgba(251,191,36,0.7)',
              0.8, 'rgba(245,158,11,0.8)',
              1, 'rgba(239,68,68,0.9)',
            ],
            'heatmap-radius': [
              'interpolate', ['linear'], ['zoom'],
              0, 15,
              6, 30,
              9, 50,
            ],
            'heatmap-opacity': 0.8,
          },
        });

        // Circle layer for zoomed-in view
        map.addLayer({
          id: 'observers-circles',
          type: 'circle',
          source: 'observers',
          minzoom: 4,
          paint: {
            'circle-radius': [
              'interpolate', ['linear'], ['get', 'count'],
              1, 10,
              10, 18,
              50, 30,
            ],
            'circle-color': [
              'interpolate', ['linear'], ['get', 'count'],
              1, '#10b981',
              10, '#f59e0b',
              50, '#ef4444',
            ],
            'circle-opacity': 0.85,
            'circle-stroke-width': 2,
            'circle-stroke-color': '#ffffff',
          },
        });

        // Count labels on circles
        map.addLayer({
          id: 'observers-labels',
          type: 'symbol',
          source: 'observers',
          minzoom: 4,
          layout: {
            'text-field': ['get', 'count'],
            'text-size': 12,
            'text-font': ['Open Sans Bold'],
            'text-allow-overlap': true,
          },
          paint: {
            'text-color': '#ffffff',
          },
        });

        // Click popup — show observer info when clicking a circle
        const maplibre2 = (await import('maplibre-gl')).default;
        map.on('click', 'observers-circles', (e) => {
          if (!e.features || e.features.length === 0 || !map) return;
          const feat = e.features[0];
          const props = feat.properties as {
            count: number;
            users: string;
          };
          const count: number = props.count;
          const users: UserSummary[] = JSON.parse(props.users ?? '[]');

          const lines = users.map(u => {
            const name = u.display_name || u.username || '—';
            const expert = u.is_expert ? ' ⭐' : '';
            const obs = STRINGS.lang === 'es'
              ? `${u.observation_count} obs.`
              : `${u.observation_count} obs.`;
            return `<div style="display:flex;align-items:center;gap:6px;padding:3px 0">
              ${u.avatar_url
                ? `<img src="${u.avatar_url}" style="width:24px;height:24px;border-radius:50%;object-fit:cover" loading="lazy">`
                : `<span style="width:24px;height:24px;border-radius:50%;background:#10b981;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px">${name[0]?.toUpperCase() ?? '?'}</span>`
              }
              <div>
                <div style="font-weight:600;font-size:13px">${name}${expert}</div>
                <div style="font-size:11px;opacity:.7">${obs}</div>
              </div>
            </div>`;
          }).join('');

          const more = count > 5
            ? `<div style="font-size:11px;opacity:.7;margin-top:4px">${STRINGS.lang === 'es' ? `y ${count - 5} más…` : `and ${count - 5} more…`}</div>`
            : '';

          const coords = (feat.geometry as GeoJSON.Point).coordinates as [number, number];
          new maplibre2.Popup({ closeButton: true, maxWidth: '260px' })
            .setLngLat(coords)
            .setHTML(`<div style="font-family:sans-serif;padding:4px 2px">${lines}${more}</div>`)
            .addTo(map);
        });

        map.on('mouseenter', 'observers-circles', () => {
          if (map) map.getCanvas().style.cursor = 'pointer';
        });
        map.on('mouseleave', 'observers-circles', () => {
          if (map) map.getCanvas().style.cursor = '';
        });
      }

      if (cells.length > 0) {
        privacyNoteEl.classList.remove('hidden');
      } else {
        noDataEl.classList.remove('hidden');
      }

      if (!isAuthenticated) {
        signInHintEl.classList.remove('hidden');
      }

    } catch (err) {
      loadingEl.classList.add('hidden');
      const msg = err instanceof Error ? err.message : String(err);
      loadingEl.textContent = msg;
      loadingEl.classList.remove('hidden');
    }
  }


  function onFilterChange() {
    const filtered = filterRows(allRows);
    updateCountBadge(filtered.length);

    if (!map) return;

    const cells = aggregateToHex(filtered, sortEl.value);
    const geojson = buildGeoJSON(cells);
    const src = map.getSource('observers') as import('maplibre-gl').GeoJSONSource | undefined;
    if (src) {
      src.setData(geojson);
    }
    if (cells.length > 0) {
      noDataEl.classList.add('hidden');
      privacyNoteEl.classList.remove('hidden');
    } else {
      privacyNoteEl.classList.add('hidden');
      if (filtered.length === 0) {
        noDataEl.classList.remove('hidden');
      }
    }
  }

  sortEl.addEventListener('change', onFilterChange);
  countryEl.addEventListener('change', onFilterChange);
  expertsEl.addEventListener('change', onFilterChange);

  void renderMap();
</script>
