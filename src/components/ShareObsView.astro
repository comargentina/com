---
import Comments from './Comments.astro';
import FollowButton from './FollowButton.astro';
import ShareButton from './ShareButton.astro';
import SuggestIdModal from './SuggestIdModal.astro';
import ReactionStrip from './ReactionStrip.astro';
import PhotoGallery from './PhotoGallery.astro';
import MapPicker from './MapPicker.astro';
import ObsManagePanel from './ObsManagePanel.astro';
import AudioPlayer from './AudioPlayer.astro';
import CascadeTrace from './CascadeTrace.astro';
import { t } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
const obsIdPlaceholder = '';

// Pull from the i18n tree in frontmatter — Astro's JSX parser fights with
// inline `Record<…>` casts, so we narrow once here and then read fields off
// typed locals in the markup.
type ObsDetailTree = {
  view: Record<string, string>;
  edit_location: string;
  save_changes: string;
  saved: string;
  edited_badge: string;
  range_extension_pill: string;
};
const tr = t(lang) as { obs_detail: ObsDetailTree };
const v  = tr.obs_detail.view;

// Labels still consumed by ShareObsView itself. Manage-panel labels
// moved into ObsManagePanel.astro in PR4.
const labels = {
  loading:           v.loading,
  region:            v.region,
  date:              v.date,
  habitat:           v.habitat,
  weather:           v.weather,
  establishment:     v.establishment,
  observer:          v.observer,
  sensitive:         v.sensitive,
  reportBtn:         v.report_btn,
  reactionsHelp:     v.reactions_help,
  communityIds:      v.community_ids,
  noSuggestions:     v.no_suggestions,
  suggestBtn:        v.suggest_btn,
  askAiBtn:          v.ask_ai_btn,
  askAiRunning:      v.ask_ai_running,
  askAiNoPhoto:      v.ask_ai_no_photo,
  askAiNoResult:     v.ask_ai_no_result,
  askAiSubmit:       v.ask_ai_submit,
  signInToSuggest:   v.signin_to_suggest,
  ownerNote:         v.owner_note,
  editLocation:      tr.obs_detail.edit_location,
  editedBadge:       tr.obs_detail.edited_badge,
  rangeExtensionPill: tr.obs_detail.range_extension_pill,
  placeChipLabel:    v.place_chip_label,
};

// EN counterparts used for data-en attrs (always English regardless of lang prop)
const en = t('en') as { obs_detail: ObsDetailTree };
const ve = en.obs_detail.view;
const labelsEn = {
  loading:           ve.loading,
  region:            ve.region,
  date:              ve.date,
  habitat:           ve.habitat,
  weather:           ve.weather,
  establishment:     ve.establishment,
  observer:          ve.observer,
  sensitive:         ve.sensitive,
  reportBtn:         ve.report_btn,
  reactionsHelp:     ve.reactions_help,
  communityIds:      ve.community_ids,
  noSuggestions:     ve.no_suggestions,
  suggestBtn:        ve.suggest_btn,
  askAiBtn:          ve.ask_ai_btn,
  askAiSubmit:       ve.ask_ai_submit,
  signInToSuggest:   ve.signin_to_suggest,
  ownerNote:         ve.owner_note,
  editLocation:      en.obs_detail.edit_location,
  editedBadge:       en.obs_detail.edited_badge,
  rangeExtensionPill: en.obs_detail.range_extension_pill,
  placeChipLabel:    ve.place_chip_label,
};

// ES counterparts used for data-es attrs
const es = t('es') as { obs_detail: ObsDetailTree };
const vs = es.obs_detail.view;
const labelsEs = {
  loading:           vs.loading,
  region:            vs.region,
  date:              vs.date,
  habitat:           vs.habitat,
  weather:           vs.weather,
  establishment:     vs.establishment,
  observer:          vs.observer,
  sensitive:         vs.sensitive,
  reportBtn:         vs.report_btn,
  reactionsHelp:     vs.reactions_help,
  communityIds:      vs.community_ids,
  noSuggestions:     vs.no_suggestions,
  suggestBtn:        vs.suggest_btn,
  askAiBtn:          vs.ask_ai_btn,
  askAiSubmit:       vs.ask_ai_submit,
  signInToSuggest:   vs.signin_to_suggest,
  ownerNote:         vs.owner_note,
  editLocation:      es.obs_detail.edit_location,
  editedBadge:       es.obs_detail.edited_badge,
  rangeExtensionPill: es.obs_detail.range_extension_pill,
  placeChipLabel:    vs.place_chip_label,
};
---

<div class="max-w-6xl mx-auto">
  <div id="loading" class="py-16 text-center text-zinc-600 dark:text-zinc-300">
    <span data-i18n data-en={labelsEn.loading} data-es={labelsEs.loading}>{labels.loading}</span>
  </div>

  <article id="obs" class="hidden">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <aside class="md:col-span-7 lg:col-span-7 space-y-3 md:sticky md:top-20 self-start">
        <PhotoGallery photos={[]} lang={lang} mode="viewer" galleryId="obs-detail" />

        <div id="best-shot-mount" class="hidden mt-3">
          <button id="best-shot-btn" type="button" class="text-xs text-zinc-600 dark:text-zinc-400 hover:text-emerald-700 dark:hover:text-emerald-400">
            📸 <span data-i18n data-en="Nominate as best shot" data-es="Nominar como mejor foto">{lang === 'es' ? 'Nominar como mejor foto' : 'Nominate as best shot'}</span>
          </button>
          <span id="best-shot-count" class="ml-2 text-xs text-zinc-600 dark:text-zinc-400"></span>
        </div>

        <div class="space-y-2">
          <MapPicker mode="view" lang={lang} pickerId="obs-detail" initialCoords={null} />
          <p data-obs-coords class="text-xs text-zinc-600 dark:text-zinc-400"></p>
          <a id="obs-place-chip" href="#" class="hidden inline-flex items-center gap-1.5 mt-1 text-sm text-emerald-700 dark:text-emerald-400 hover:underline">
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span data-i18n data-en={labelsEn.placeChipLabel} data-es={labelsEs.placeChipLabel}>{labels.placeChipLabel}</span>
          </a>
          <button
            type="button"
            id="obs-edit-location-btn"
            data-show-when="owner"
            class="hidden text-xs text-emerald-700 dark:text-emerald-400 underline"
            disabled
            aria-disabled="true"
            data-i18n-title
            data-en-title={labelsEn.editLocation}
            data-es-title={labelsEs.editLocation}
          >
            <span data-i18n data-en={labelsEn.editLocation} data-es={labelsEs.editLocation}>{labels.editLocation}</span>
          </button>
        </div>

        <!-- Audio player mount — populated dynamically when audio media_files exist.
             The page script injects `.rastrum-audio-player-mount` nodes; the
             hidden `<AudioPlayer>` below ensures Astro bundles the lib so
             those mounts have something to attach to. -->
        <div id="obs-audio-players" class="hidden space-y-3"></div>
        <div class="hidden" aria-hidden="true">
          <AudioPlayer audioUrl="" lang={lang} obsId="__anchor" />
        </div>
      </aside>

      <section class="md:col-span-5 lg:col-span-5 space-y-6">
        <header class="space-y-2">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h1 id="species" class="text-3xl md:text-4xl font-bold italic text-zinc-900 dark:text-zinc-100"></h1>
              <p id="meta" class="text-sm text-zinc-600 dark:text-zinc-400"></p>
            </div>
            <div class="flex items-center gap-2">
              <div id="follow-mount">
                <FollowButton lang={lang} />
              </div>
              <ShareButton lang={lang} id="obs-share-btn" />
              <button
                id="obs-report-btn"
                type="button"
                class="hidden inline-flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-700 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
                aria-label={labels.reportBtn}
                title={labels.reportBtn}
                data-i18n-aria-label
                data-i18n-title
                data-en-aria-label={labelsEn.reportBtn}
                data-es-aria-label={labelsEs.reportBtn}
                data-en-title={labelsEn.reportBtn}
                data-es-title={labelsEs.reportBtn}
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4a2 2 0 0 1 2-2h11l4 6-4 6H6"/><line x1="4" y1="22" x2="4" y2="14"/></svg>
              </button>
            </div>
          </div>
        </header>

        <div id="reactions-mount" class="flex items-center gap-3">
          <ReactionStrip lang={lang} target="observation" targetId={obsIdPlaceholder} size="md" />
          <span id="reactions-help" class="hidden text-xs text-zinc-600 dark:text-zinc-300">
            <span data-i18n data-en={labelsEn.reactionsHelp} data-es={labelsEs.reactionsHelp}>{labels.reactionsHelp}</span>
          </span>
        </div>

        <p id="sensitive" class="hidden text-sm text-amber-700 dark:text-amber-400 border-l-4 border-amber-500 pl-3">
          <span data-i18n data-en={labelsEn.sensitive} data-es={labelsEs.sensitive}>{labels.sensitive}</span>
        </p>

        <p
          id="edited-badge"
          data-edited-badge
          class="hidden text-xs text-amber-700 dark:text-amber-400 border-l-4 border-amber-500 pl-3 py-1"
        ><span data-i18n data-en={labelsEn.editedBadge} data-es={labelsEs.editedBadge}>{labels.editedBadge}</span></p>

        <p
          id="range-extension-pill"
          data-range-extension-pill
          class="hidden inline-flex items-center gap-1.5 rounded-full bg-violet-100 dark:bg-violet-900/30 px-2.5 py-0.5 text-[11px] font-semibold text-violet-800 dark:text-violet-300"
          title={labels.rangeExtensionPill}
        >
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/>
          </svg>
          <span data-i18n data-en={labelsEn.rangeExtensionPill} data-es={labelsEs.rangeExtensionPill}>{labels.rangeExtensionPill}</span>
        </p>

        <dl class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={labelsEn.date} data-es={labelsEs.date}>{labels.date}</dt>
            <dd id="date" class="font-medium"></dd>
          </div>
          <div>
            <dt class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={labelsEn.region} data-es={labelsEs.region}>{labels.region}</dt>
            <dd id="region" class="font-medium">—</dd>
          </div>
          <div>
            <dt class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={labelsEn.habitat} data-es={labelsEs.habitat}>{labels.habitat}</dt>
            <dd id="habitat" class="font-medium">—</dd>
          </div>
          <div>
            <dt class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={labelsEn.weather} data-es={labelsEs.weather}>{labels.weather}</dt>
            <dd id="weather" class="font-medium">—</dd>
          </div>
          <div>
            <dt class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={labelsEn.establishment} data-es={labelsEs.establishment}>{labels.establishment}</dt>
            <dd id="establishment" class="font-medium">—</dd>
          </div>
          <div>
            <dt class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={labelsEn.observer} data-es={labelsEs.observer}>{labels.observer}</dt>
            <dd id="observer" class="font-medium">—</dd>
          </div>
        </dl>

        <CascadeTrace lang={lang} variant="inline" traceId="obs-cascade" />

        <section id="community-ids" class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-4 space-y-3">
          <div class="flex items-start justify-between gap-2 flex-wrap">
            <div>
              <h2 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider" data-i18n data-en={labelsEn.communityIds} data-es={labelsEs.communityIds}>{labels.communityIds}</h2>
              <p id="community-ids-empty" class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">
                <span data-i18n data-en={labelsEn.noSuggestions} data-es={labelsEs.noSuggestions}>{labels.noSuggestions}</span>
              </p>
            </div>
            <button id="ci-suggest-btn" type="button" class="hidden rounded-lg bg-emerald-700 hover:bg-emerald-800 px-3 py-1.5 text-xs font-semibold text-white">
              <span data-i18n data-en={labelsEn.suggestBtn} data-es={labelsEs.suggestBtn}>{labels.suggestBtn}</span>
            </button>
            <a id="ask-rastrum-link" href={`/${lang}/chat/`} class="inline-flex items-center gap-1 min-h-9 rounded-lg border border-emerald-600/60 px-3 py-1.5 text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/10" aria-label={lang === 'es' ? 'Pregunta a la IA del COM' : 'Ask COM AI'} title={lang === 'es' ? 'Pregunta a la IA del COM' : 'Ask COM AI'}>
              <span aria-hidden="true">💬</span>
              <span data-i18n data-en="Ask" data-es="Pregunta">{lang === 'es' ? 'Pregunta' : 'Ask'}</span>
            </a>
            <button
              id="ci-ask-ai-btn"
              type="button"
              class="hidden rounded-lg border border-emerald-600/60 px-3 py-1.5 text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20"
              data-label-running={labels.askAiRunning}
              data-label-idle={labels.askAiBtn}
              data-label-no-photo={labels.askAiNoPhoto}
              data-label-no-result={labels.askAiNoResult}
              data-label-submit={labels.askAiSubmit}
            >
              <span data-i18n data-en={labelsEn.askAiBtn} data-es={labelsEs.askAiBtn}>{labels.askAiBtn}</span>
            </button>
            <div id="ci-ai-result" class="hidden w-full mt-2 rounded-lg border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/20 p-3 text-sm space-y-2">
              <p id="ci-ai-result-text" class="font-medium italic text-emerald-700 dark:text-emerald-400"></p>
              <p id="ci-ai-result-meta" class="text-xs text-zinc-600 dark:text-zinc-400"></p>
              <button id="ci-ai-submit-btn" type="button" class="hidden rounded-lg bg-emerald-700 hover:bg-emerald-800 px-3 py-1.5 text-xs font-semibold text-white">
                <span data-i18n data-en={labelsEn.askAiSubmit} data-es={labelsEs.askAiSubmit}>{labels.askAiSubmit}</span>
              </button>
            </div>
            <a id="ci-signin-link" href="/en/sign-in/" class="hidden rounded-lg border border-emerald-600/60 px-3 py-1.5 text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20">
              <span data-i18n data-en={labelsEn.signInToSuggest} data-es={labelsEs.signInToSuggest}>{labels.signInToSuggest}</span>
            </a>
            <span id="ci-owner-note" class="hidden text-xs text-zinc-600 dark:text-zinc-300 italic">
              <span data-i18n data-en={labelsEn.ownerNote} data-es={labelsEs.ownerNote}>{labels.ownerNote}</span>
            </span>
          </div>
          <ul id="ci-list" class="space-y-1.5 text-sm"></ul>
        </section>

        <ObsManagePanel lang={lang} />

        <div id="social-mount" class="hidden">
          <Comments lang={lang} observationId={obsIdPlaceholder} />
        </div>
      </section>
    </div>
  </article>

  <div id="err" class="hidden py-16 text-center text-red-600 dark:text-red-400"></div>
</div>

<SuggestIdModal lang={lang} />
