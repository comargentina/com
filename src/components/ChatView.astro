  // ── Cascade helpers ──
  async function runAttachmentCascade(att: ChatAttachment, currentTurnText: string): Promise<{
    best: CascadeCandidate | null;
    alternates: CascadeCandidate[];
  }> {
    const { bootstrapIdentifiers, runCascade } = await import('../lib/identifiers');
    bootstrapIdentifiers();
    const mediaKind = att.kind === 'photo' ? 'photo' : 'audio';
    const { buildCascadeOptions } = await import('../lib/identify-options');
    // #593: derive user_hint from conversation context (current turn
    // keywords + propagated kingdom from prior winning IDs).
    const { deriveHintFromConversation } = await import('../lib/chat-hint');
    const userHint = deriveHintFromConversation(currentTurnText, conversation);
    const opts = await buildCascadeOptions({ mediaKind, userHint });
    // Phi-vision is now self-gated via isAvailable() (opt-in pref) — no
    // need to exclude it explicitly. Users who don't opt in won't see Phi
    // run; users who opt in get it as part of the natural cascade.
    const result = await runCascade(
      {
        media: { kind: 'blob', blob: att.blob, mime: att.mimeType },
        mediaKind,
        byo_keys: {},
      },
      {
        media: mediaKind,
        ...opts,
      },
    );
    const best = result.best ? toCandidate(result.best) : null;
    const alternates = result.attempts
      .filter(a => a.ok && a.result && a.result !== result.best)
      .map(a => toCandidate(a.result!))
      .filter(c => c.scientific_name);
    return { best, alternates };
  }

  /**
   * Force a single registered identifier to run on the attachment, bypassing
   * the cascade entirely. Returns the result as a CascadeCandidate or throws
   * with a human-readable error (so the caller can render it inline).
   */
  async function runForcedIdentify(att: ChatAttachment, providerId: string): Promise<CascadeCandidate> {
    const { bootstrapIdentifiers } = await import('../lib/identifiers');
    bootstrapIdentifiers();
    const { registry } = await import('../lib/identifiers/registry');
    const plugin = registry.get(providerId);
    if (!plugin) throw new Error(`unknown identifier: ${providerId}`);
    const av = await plugin.isAvailable();
    if (!av.ready) {
      throw new Error(av.message ?? av.reason ?? 'unavailable');
    }
    const mediaKind = att.kind === 'photo' ? 'photo' : 'audio';
    const result = await plugin.identify({
      media: { kind: 'blob', blob: att.blob, mime: att.mimeType },
      mediaKind,
      byo_keys: {},
    });
    return toCandidate(result);
  }

  /**
   * Compare-all: fan out to every registered identifier that matches the
   * media type and return per-plugin results in parallel. Plugins whose
   * isAvailable() returns false are still surfaced so the user sees why
   * (e.g. needs key, needs download, opt-in required).
   */
  async function runCompareOnAttachment(att: ChatAttachment): Promise<Array<{
    id: string;
    name: string;
    ok: boolean;
    result?: CascadeCandidate;
    error?: string;
  }>> {
    const { bootstrapIdentifiers } = await import('../lib/identifiers');
    bootstrapIdentifiers();
    const { registry } = await import('../lib/identifiers/registry');
    const mediaKind = att.kind === 'photo' ? 'photo' : 'audio';
    const plugins = registry.findFor({ media: mediaKind });

    const probes = await Promise.all(plugins.map(async (p) => {
      const av = await p.isAvailable().catch((e: unknown) => ({
        ready: false as const,
        reason: 'error',
        message: e instanceof Error ? e.message : String(e),
      }));
      return { plugin: p, av };
    }));

    const runs = await Promise.allSettled(probes.map(async ({ plugin, av }) => {
      if (!av.ready) {
        return { id: plugin.id, name: plugin.name, ok: false, error: av.message ?? av.reason ?? 'unavailable' };
      }
      try {
        const r = await plugin.identify({
          media: { kind: 'blob', blob: att.blob, mime: att.mimeType },
          mediaKind,
          byo_keys: {},
        });
        return { id: plugin.id, name: plugin.name, ok: true, result: toCandidate(r) };
      } catch (e) {
        return { id: plugin.id, name: plugin.name, ok: false, error: e instanceof Error ? e.message : String(e) };
      }
    }));

    return runs.map((r, i) => r.status === 'fulfilled'
      ? r.value
      : { id: probes[i].plugin.id, name: probes[i].plugin.name, ok: false, error: r.reason instanceof Error ? r.reason.message : String(r.reason) });
  }

  function toCandidate(r: {
    scientific_name: string; common_name_en: string | null; common_name_es: string | null;
    family: string | null; kingdom: string; confidence: number; source: string;
  }): CascadeCandidate {
    return {
      scientific_name: r.scientific_name,
      common_name_en: r.common_name_en,
      common_name_es: r.common_name_es,
      family: r.family,
      kingdom: r.kingdom,
      confidence: r.confidence,
      source: r.source,
    };
  }

  /** Convert a Blob to a data URL — needed for Phi-3.5-vision and Claude vision payloads. */
  function blobToDataUrl(blob: Blob): Promise<string> {
    return new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(r.result as string);
      r.onerror = () => reject(r.error);
      r.readAsDataURL(blob);
    });
  }

  /** Best-effort vision-LLM fallback. Returns the text reply or null if unavailable.
   *
   * Priority:
   *   1. Gemini Flash (BYO key in localStorage — zero download, cloud vision)
   *   2. Claude Haiku (BYO Anthropic key)
   *   3. Phi-3.5-vision (local WebLLM — requires 4 GB model download)
   */
  async function runVisionFallback(
    att: ChatAttachment,
    userText: string,
    onUpdate: (s: string) => void,
  ): Promise<string | null> {
    if (att.kind !== 'photo') return null;

    // 1. Try Gemini Flash vision (BYO key, no download required)
    const geminiReply = await tryGeminiVisionFallback(att, userText, onUpdate);
    if (geminiReply) return geminiReply;

    // 2. Try Claude BYO key
    const claudeReply = await tryClaudeVisionFallback(att, userText);
    if (claudeReply) return claudeReply;

    // 3. Fall back to local Phi-3.5-vision only when no cloud vision path exists:
    //    - Skip if the quota banner is visible (no key → user is being asked to enter one)
    //    - Skip if a Gemini key is saved (Gemini was already tried; don't confuse the user
    //      with a 4 GB download dialog after "Analizando imagen con Gemini..." already ran)
    if (quotaBanner && !quotaBanner.classList.contains('hidden')) return null;
    const { readAllGeminiKeys: _checkKeys } = await import('../lib/chat-engine');
    if (_checkKeys().length > 0) return null;

    const lib = await import('../lib/local-ai');
    if (!lib.localAISupported()) return null;

    const status = await lib.getModelCacheStatus(lib.VISION_MODEL_ID);
    if (!status.cached) {
      if (!visionDialog) return null;
      visionDialog.returnValue = '';
      const ok: boolean = await new Promise((resolve) => {
        const handler = () => { resolve(visionDialog.returnValue === 'ok'); visionDialog.removeEventListener('close', handler); };
        visionDialog.addEventListener('close', handler);
        visionDialog.showModal();
      });
      if (!ok) return null;
      onUpdate(i18nGet('vision-download-progress'));
      try {
        await lib.loadVisionEngine((p) => {
          onUpdate(`${i18nGet('vision-download-progress')} ${Math.round((p.progress ?? 0) * 100)}%`);
        });
      } catch {
        return null;
      }
    }
    onUpdate(i18nGet('looking-more-carefully'));
    const rawDataUrl = await blobToDataUrl(att.blob);
    // Phi-3.5-vision MLC needs a 336×336 single-crop input. See
    // src/lib/local-ai.ts → prepareImageForPhi.
    const dataUrl = await lib.prepareImageForPhi(rawDataUrl, 336);
    const engine = await lib.loadVisionEngine(() => {});
    const prompt = buildVisionFallbackPrompt({ userText, locale: docLocale });
    const reply = await engine.chat.completions.create({
      messages: [{
        role: 'user',
        content: [
          { type: 'image_url', image_url: { url: dataUrl } },
          { type: 'text', text: prompt },
        ],
      }],
      max_tokens: 256,
    });
    const raw = reply.choices?.[0]?.message?.content ?? '';
    return typeof raw === 'string' ? raw.trim() : null;
  }

  /**
   * Send a photo to Gemini Flash using the BYO key stored in localStorage.
   * Returns the text reply, or null if no key is present or the call fails.
   * When no key is found, surfaces the quota banner so the user can paste
   * their free Google AI Studio key without needing to download anything.
   */
  async function tryGeminiVisionFallback(
    att: ChatAttachment,
    userText: string,
    onUpdate: (s: string) => void,
  ): Promise<string | null> {
    if (att.kind !== 'photo') return null;
    const { readAllGeminiKeys, rotateGeminiKeys } = await import('../lib/chat-engine');
    const keys = readAllGeminiKeys();
    if (keys.length === 0) {
      quotaBanner?.classList.remove('hidden');
      return null;
    }
    try {
      let processedBlob = att.blob;
      try {
        const { resizeImage } = await import('../lib/upload');
        processedBlob = await resizeImage(
          new File([att.blob], 'obs.jpg', { type: att.blob.type || 'image/jpeg' }),
          { maxLongEdge: 1024, quality: 0.85 },
        );
      } catch {
        /* keep original blob if resize fails */
      }

      const dataUrl = await blobToDataUrl(processedBlob);
      const m = /^data:([^;]+);base64,(.+)$/.exec(dataUrl);
      if (!m) return null;
      const [, mimeType, base64] = m;
      const prompt = buildVisionFallbackPrompt({ userText, locale: docLocale });

      const cleanMime = (mimeType || 'image/jpeg').split(';')[0].trim();
      const makeBody = () => JSON.stringify({
        contents: [{
          role: 'user',
          parts: [
            {
              inlineData: {
                mimeType: cleanMime,
                data: base64,
              },
            },
            { text: prompt },
          ],
        }],
        generationConfig: { maxOutputTokens: 2048, temperature: 0.4 },
      });

      // gemini-3.5-flash and gemini-3.5-flash-lite: confirmed active models in Google AI Studio.
      // (1.5-flash and 2.5-flash have been deprecated/retired by Google).
      const MODELS = ['gemini-3.5-flash', 'gemini-3.5-flash-lite'];
      const accountErrors: string[] = [];
      let anyHitRateLimit = false;

      for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        if (i === 0) onUpdate(isEs ? 'Analizando imagen con Gemini…' : 'Analysing image with Gemini…');

        let hitRateLimit = false;
        let authFailed = false;
        const failedAttempts: string[] = [];

        for (const model of MODELS) {
          if (hitRateLimit || authFailed) break;

          const ac = new AbortController();
          const t = setTimeout(() => ac.abort(), 20_000);
          let res: Response;
          try {
            res = await fetch(
              `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent`,
              {
                method: 'POST',
                signal: ac.signal,
                headers: { 'content-type': 'application/json', 'x-goog-api-key': key },
                body: makeBody(),
              },
            ).finally(() => clearTimeout(t));
          } catch {
            failedAttempts.push(`${model}: timeout/network`);
            continue;
          }

          if (res.status === 429) {
            hitRateLimit = true;
            anyHitRateLimit = true;
            failedAttempts.push(isEs ? 'Límite de cuota (429)' : 'Quota limit (429)');
            break;
          }

          // 401/403 means the key is invalid — no point retrying other models with the same key.
          if (res.status === 401 || res.status === 403) {
            authFailed = true;
            failedAttempts.push(`${model}: HTTP ${res.status} (clave inválida)`);
            break;
          }

          if (!res.ok) {
            let errMsg = `HTTP ${res.status}`;
            try {
              const errJson = await res.json() as { error?: { message?: string } };
              if (errJson?.error?.message) errMsg = errJson.error.message;
            } catch { /* ignore */ }
            failedAttempts.push(`${model}: ${errMsg}`);
            continue;
          }

          const data = await res.json() as { candidates?: Array<{ content?: { parts?: Array<{ text?: string }> } }> };
          const text = data.candidates?.[0]?.content?.parts?.find(p => p.text)?.text?.trim() ?? null;
          if (text) return text;
        }

        if (failedAttempts.length > 0) {
          accountErrors.push(`Cuenta ${i + 1}: ${failedAttempts[failedAttempts.length - 1]}`);
        }

        if (hitRateLimit && i < keys.length - 1) {
          rotateGeminiKeys();
          continue;
        }
      }

      // If any account hit quota (even if others timed out), credits reset in 24h — no banner needed.
      if (anyHitRateLimit) {
        return isEs
          ? '⏳ Los créditos de análisis de imagen se agotaron por hoy. Se restablecen automáticamente en 24 horas. Volvé a intentar mañana, o podés ingresar tu propia clave en el panel 🔑.'
          : '⏳ Image analysis credits are exhausted for today. They reset automatically in 24 hours. Try again tomorrow, or add your own free key via the 🔑 panel.';
      }

      // All keys failed for non-quota reasons — open the banner so the user can fix/add keys.
      quotaBanner?.classList.remove('hidden');
      quotaBanner?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      const detailSuffix = accountErrors.length > 0 ? ` (${accountErrors.join(' | ')})` : '';
      return isEs
        ? `⚠️ No se pudo analizar la imagen con las cuentas configuradas${detailSuffix}. Abrimos el panel de claves arriba para que puedas verificarlas o actualizarlas.`
        : `⚠️ Could not analyse the image with the configured accounts${detailSuffix}. We opened the keys panel above so you can verify or update them.`;
    } catch {
      return null;
    }
  }

  /** If any Anthropic key is resolvable (project, runtime, or BYO), send the image to Claude Haiku for a vision-native reply. */
  async function tryClaudeVisionFallback(att: ChatAttachment, userText: string): Promise<string | null> {
    if (att.kind !== 'photo') return null;
    try {
      const { resolveAnthropicKey } = await import('../lib/anthropic-key');
      const { key } = await resolveAnthropicKey();
      if (!key) return null;
      const dataUrl = await blobToDataUrl(att.blob);
      const m = /^data:([^;]+);base64,(.+)$/.exec(dataUrl);
      if (!m) return null;
      const [, mediaType, base64] = m;
      const prompt = buildVisionFallbackPrompt({ userText, locale: docLocale });
      const ac = new AbortController();
      const t = setTimeout(() => ac.abort(), 25_000);
      const res = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        signal: ac.signal,
        headers: {
          'x-api-key': key,
          'anthropic-version': '2023-06-01',
          'anthropic-dangerous-direct-browser-access': 'true',
          'content-type': 'application/json',
        },
        body: JSON.stringify({
          model: 'claude-haiku-4-5',
          max_tokens: 400,
          messages: [{
            role: 'user',
            content: [
              { type: 'image', source: { type: 'base64', media_type: mediaType, data: base64 } },
              { type: 'text', text: prompt },
            ],
          }],
        }),
      }).finally(() => clearTimeout(t));
      if (!res.ok) return null;
      const data = await res.json() as { content?: Array<{ type: string; text?: string }> };
      const piece = data.content?.find(p => p.type === 'text');
      return piece?.text?.trim() ?? null;
    } catch {
      return null;
    }
  }

  // ── Send ──
  formEl?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (busy || !inputEl || !sendBtn || !sendLabel) return;
    const text = inputEl.value.trim();
    const att = pendingAttachment;
    if (!text && !att) return;
    busy = true;
    sendBtn.disabled = true;
    sendLabel.textContent = SEND_BUSY;

    // Detach the staged attachment from the chip immediately so the user
    // can stage another while this turn streams.
    pendingAttachment = null;
    attachChip?.classList.add('hidden');
    modelPickerEl?.classList.add('hidden');
    if (attachThumb) attachThumb.innerHTML = '';
    if (attachLabel) attachLabel.textContent = '';
    if (attachMeta) attachMeta.textContent = '';

    conversation.push({ role: 'user', content: text, attachment: att ?? undefined });
    persistUserTurn(text, att);
    inputEl.value = '';
    autosize();

    // Picker: only meaningful for photos. Audio always rides the cascade.
    const pickerChoice: ModelPickerChoice = (att?.kind === 'photo') ? readModelPick() : 'auto';

    if (att && pickerChoice === 'compare') {
      conversation.push({ role: 'assistant', content: i18nGet('compare-running'), pending: true });
      paintConversation();
      const placeholderIdx = conversation.length - 1;
      try {
        const entries = await runCompareOnAttachment(att);
        conversation[placeholderIdx].compareResult = {
          attachmentKind: att.kind,
          attachmentBlobUrl: att.objectUrl,
          attachmentMime: att.mimeType,
          entries,
        };
        conversation[placeholderIdx].content = '';
        conversation[placeholderIdx].pending = false;
      } catch (err) {
        conversation[placeholderIdx].content = (isEs ? 'Error: ' : 'Error: ') + (err instanceof Error ? err.message : String(err));
        conversation[placeholderIdx].pending = false;
      }
      paintConversation();
      persistAssistantTurn(conversation[placeholderIdx]);
      busy = false;
      sendBtn.disabled = false;
      sendLabel.textContent = SEND_DEFAULT;
      return;
    }

    if (att && pickerChoice !== 'auto') {
      conversation.push({ role: 'assistant', content: i18nGet('identifying'), pending: true });
      paintConversation();
      const placeholderIdx = conversation.length - 1;
      try {
        const result = await runForcedIdentify(att, pickerChoice);
        conversation[placeholderIdx].cascadeResult = {
          best: result,
          attachmentKind: att.kind,
          attachmentBlobUrl: att.objectUrl,
          attachmentMime: att.mimeType,
        };
        conversation[placeholderIdx].content = '';
        conversation[placeholderIdx].pending = false;
        paintConversation();
        await streamGeminiInterpretation(placeholderIdx, att, text, result, []);
      } catch (err) {
        conversation[placeholderIdx].content = (isEs ? 'Modelo no disponible: ' : 'Model unavailable: ') + (err instanceof Error ? err.message : String(err));
        conversation[placeholderIdx].pending = false;
        paintConversation();
        persistAssistantTurn(conversation[placeholderIdx]);
      }
      busy = false;
      sendBtn.disabled = false;
      sendLabel.textContent = SEND_DEFAULT;
      return;
    }

    if (att) {
      // Add a placeholder bot turn while the cascade runs.
      const placeholderText = att.kind === 'audio'
        ? i18nGet('identifying-audio')
        : i18nGet('identifying');
      conversation.push({ role: 'assistant', content: placeholderText, pending: true });
      paintConversation();
      const placeholderIdx = conversation.length - 1;

      try {
        const { best, alternates } = await runAttachmentCascade(att, text);
        const ACCEPT_LOW = 0.4;
        const cascadeOk = !!best && best.confidence >= ACCEPT_LOW;

        if (cascadeOk) {
          conversation[placeholderIdx].cascadeResult = {
            best,
            attachmentKind: att.kind,
            attachmentBlobUrl: att.objectUrl,
            attachmentMime: att.mimeType,
          };
          conversation[placeholderIdx].content = '';
          conversation[placeholderIdx].pending = false;
          paintConversation();
          await streamGeminiInterpretation(placeholderIdx, att, text, best, alternates);
        } else {
          // Cascade failed → try vision fallback (photo only).
          if (att.kind === 'photo') {
            conversation[placeholderIdx].content = i18nGet('looking-more-carefully');
            paintConversation();
            const reply = await runVisionFallback(att, text, (s) => {
              conversation[placeholderIdx].content = s;
              setBubbleStreaming(placeholderIdx, s);
            });
            if (reply) {
              conversation[placeholderIdx].content = reply;
              conversation[placeholderIdx].pending = false;
              if (best) {
                conversation[placeholderIdx].cascadeResult = {
                  best,
                  attachmentKind: att.kind,
                  attachmentBlobUrl: att.objectUrl,
                  attachmentMime: att.mimeType,
                };
              }
            } else {
              conversation[placeholderIdx].content = isEs
                ? '🔍 No pude identificar la imagen. Ingresá tu clave gratuita de Google AI Studio arriba para habilitar la visión con Gemini Flash (sin descargas).'
                : '🔍 Could not identify the image. Enter your free Google AI Studio key above to enable Gemini Flash vision (no download needed).';
              conversation[placeholderIdx].pending = false;
            }
            paintConversation();
            persistAssistantTurn(conversation[placeholderIdx]);
          } else {
            // Audio with no confident match — there's no audio LLM fallback.
            conversation[placeholderIdx].content = i18nGet('cascade-no-match') + ' ' + (best?.scientific_name
              ? (isEs ? `Mejor candidato: ${best.scientific_name} (${Math.round(best.confidence * 100)}%).`
                      : `Best candidate: ${best.scientific_name} (${Math.round(best.confidence * 100)}%).`)
              : '');
            conversation[placeholderIdx].pending = false;
            if (best) {
              conversation[placeholderIdx].cascadeResult = {
                best,
                attachmentKind: att.kind,
                attachmentBlobUrl: att.objectUrl,
                attachmentMime: att.mimeType,
              };
            }
            paintConversation();
            persistAssistantTurn(conversation[placeholderIdx]);
          }
        }
      } catch (err) {
        conversation[placeholderIdx].content = (isEs ? 'Error: ' : 'Error: ') + (err instanceof Error ? err.message : String(err));
        conversation[placeholderIdx].pending = false;
        paintConversation();
        persistAssistantTurn(conversation[placeholderIdx]);
      }
    } else {
      // Text-only flow via Gemini Flash
      conversation.push({ role: 'assistant', content: '' });
      paintConversation();
      const assistantIdx = conversation.length - 1;
      const attached = (window as Window & { __chatGetAttachedEntity?: () => unknown }).__chatGetAttachedEntity?.() as
        | { kind: string; summary_text: string; label: string; suggested_questions?: string[] }
        | null
        | undefined;

      try {
        const { streamChat } = await import('../lib/chat-engine');
        type ChatMsg = { role: 'system' | 'user' | 'assistant' | 'tool'; content: string };
        const messages: ChatMsg[] = [
          { role: 'system', content: CHAT_SYSTEM_PROMPT },
          ...(attached ? [{ role: 'system' as const, content: `[Context — attached ${attached.kind}]\n${attached.summary_text}` }] : []),
          ...conversation
            .slice(0, -1)
            .filter(t => !t.attachment)
            .slice(-6)
            .map(t => ({ role: t.role as ChatMsg['role'], content: t.content.slice(0, 600) })),
        ];

        let assembled = '';
        for await (const event of streamChat({ messages })) {
          if (event.type === 'text') {
            assembled += event.delta;
            conversation[assistantIdx].content = assembled;
            setBubbleStreaming(assistantIdx, assembled);
          } else if (event.type === 'quota_exceeded') {
            quotaBanner?.classList.remove('hidden');
            conversation[assistantIdx].content = isEs
              ? '⚡ Límite de uso gratuito alcanzado. Por favor ingresá tu clave de Google AI Studio arriba para continuar.'
              : '⚡ Free usage limit reached. Please enter your Google AI Studio key above to continue.';
            paintConversation();
          } else if (event.type === 'error') {
            conversation[assistantIdx].content = (isEs ? 'Error: ' : 'Error: ') + event.message;
            paintConversation();
          } else if (event.type === 'tool_call') {
            window.dispatchEvent(new CustomEvent('rastrum:onboarding-event', {
              detail: { type: 'chat.tool.called', tool_name: event.tool, ok: true },
            }));
          } else if (event.type === 'tool_result') {
            const r = event.result as { error?: string };
            if (r.error) {
              window.dispatchEvent(new CustomEvent('rastrum:onboarding-event', {
                detail: { type: 'chat.tool.failed', tool_name: event.tool, reason: r.error },
              }));
            }
          }
        }
        paintConversation();
        persistAssistantTurn(conversation[assistantIdx]);
      } catch (err) {
        conversation[assistantIdx].content = (isEs ? 'Error: ' : 'Error: ') + (err instanceof Error ? err.message : String(err));
        paintConversation();
        persistAssistantTurn(conversation[assistantIdx]);
      }
    }

    busy = false;
    sendBtn.disabled = false;
    sendLabel.textContent = SEND_DEFAULT;
  });

  /** Stream a Gemini interpretation of the cascade result into a specific bubble. */
  async function streamGeminiInterpretation(
    idx: number,
    att: ChatAttachment,
    userText: string,
    best: CascadeCandidate,
    alternates: CascadeCandidate[],
  ): Promise<void> {
    const prompt = buildCascadeInterpretationPrompt({
      kind: att.kind, userText, locale: docLocale, best, alternates,
    });
    const { streamChat } = await import('../lib/chat-engine');
    let assembled = '';
    try {
      for await (const ev of streamChat({
        messages: [
          { role: 'system', content: CHAT_SYSTEM_PROMPT },
          { role: 'user', content: prompt },
        ],
      })) {
        if (ev.type === 'text') {
          assembled += ev.delta;
          conversation[idx].content = assembled;
          setBubbleStreaming(idx, assembled);
        } else if (ev.type === 'quota_exceeded') {
          quotaBanner?.classList.remove('hidden');
        }
      }
    } catch {
      // ignore
    }
    conversation[idx].pending = false;
    paintConversation();
    persistAssistantTurn(conversation[idx]);
  }

  // ── Voice input (SpeechRecognition) ──
  let voiceRecognition: SpeechRecognitionLike | null = null;
  let voiceFinalText = '';
  const VOICE_DEFAULT_LABEL = i18nGet('voice-input-label') || (isEs ? 'Dictar con voz' : 'Dictate with voice');
  const VOICE_STOP_LABEL    = i18nGet('voice-input-stop-label') || (isEs ? 'Detener dictado' : 'Stop dictation');

  if (voiceBtn) {
    if (!isSpeechRecognitionSupported()) {
      voiceBtn.hidden = true;
    } else {
      voiceBtn.hidden = false;
      voiceBtn.addEventListener('click', () => {
        if (voiceRecognition) {
          voiceRecognition.stop();
          return;
        }
        startVoiceRecognition();
      });
    }
  }

  function startVoiceRecognition(): void {
    if (!inputEl) return;
    const rec = createSpeechRecognition({
      lang: speechRecognitionLang(docLocale),
      continuous: true,
      interimResults: true,
    });
    if (!rec) return;
    voiceFinalText = inputEl.value;
    voiceRecognition = rec;
    setVoiceBtnRecording(true);

    rec.onresult = (ev) => {
      let interim = '';
      for (let i = ev.resultIndex; i < ev.results.length; i++) {
        const result = ev.results[i];
        const piece = result[0]?.transcript ?? '';
        if (result.isFinal) {
          voiceFinalText = (voiceFinalText + ' ' + piece).trim();
        } else {
          interim += piece;
        }
      }
      if (!inputEl) return;
      // Show finalized text as-is; interim text is appended (visually italic
      // would need a contentEditable surface, so we simply concatenate here).
      inputEl.value = interim ? `${voiceFinalText} ${interim}`.trim() : voiceFinalText;
      autosize();
    };

    rec.onerror = () => stopVoiceRecognition();
    rec.onend = () => stopVoiceRecognition();
    try { rec.start(); } catch { stopVoiceRecognition(); }
  }

  function stopVoiceRecognition(): void {
    voiceRecognition = null;
    setVoiceBtnRecording(false);
  }

  function setVoiceBtnRecording(rec: boolean): void {
    if (!voiceBtn) return;
    voiceBtn.classList.toggle('border-red-500', rec);
    voiceBtn.classList.toggle('text-red-600', rec); voiceBtn.classList.toggle('dark:text-red-400', rec);
    voiceBtn.classList.toggle('dark:text-red-400', rec);
    const label = rec ? VOICE_STOP_LABEL : VOICE_DEFAULT_LABEL;
    voiceBtn.setAttribute('aria-label', label);
    voiceBtn.setAttribute('title', label);
    if (voiceBtnLabel) voiceBtnLabel.textContent = label;
  }

  // ──────────────────────────────────────────────────────────────────────
  // Entity context (M01 chat improvements, 2026-05-09)
  //
  // Three concerns wired here:
  //   1. Deep-link: ?attach=kind:id on page load → fetch + render chip
  //   2. Picker: composer button dispatches rastrum:chat-open-entity-picker;
  //      the ChatEntityPicker dialog handles the rest, then dispatches
  //      rastrum:chat-attach-entity which we listen for below.
  //   3. Plain-text turns with attached context → chat-engine.streamChat
  //      (Gemma 4 default, Llama fallback). Photo/audio cascade paths
  //      stay unchanged.
  // ──────────────────────────────────────────────────────────────────────
  (async () => {
    const { bootstrapChatEntities, registry } = await import('../lib/chat-entities');
    bootstrapChatEntities();

    type EntityCardLite = import('../lib/chat-entities/types').EntityCard;
    type EntityKindLite = import('../lib/chat-entities/types').EntityKind;
    let attachedEntity: EntityCardLite | null = null;

    function renderEntityChipFor(card: EntityCardLite): void {
      const slot = document.getElementById('chat-entity-chip-slot');
      if (!slot) return;
      import('../lib/chat-bubble-html').then(({ entityChipHtml }) => {
        slot.innerHTML = entityChipHtml({
          kind: card.kind,
          id: card.id,
          label: card.label,
          icon: registry.get(card.kind)?.icon ?? '·',
          lang: isEs ? 'es' : 'en',
        });
        slot.querySelector('[data-chip-detach]')?.addEventListener('click', (ev) => {
          ev.preventDefault();
          document.dispatchEvent(new CustomEvent('rastrum:chat-detach-entity'));
        });
      });
    }

    function localizeQuestion(q: string): string {
      if (!isEs || !q) return q;
      if (/how is my karma calculated/i.test(q)) return '¿Cuándo una observación es primaria?';
      if (/what badges am i close to earning/i.test(q)) return '¿Qué insignias me faltan por ganar?';
      if (/show my last 10 observations/i.test(q)) return 'Mostrame mis últimas 10 observaciones.';
      if (/why is this research grade/i.test(q)) return '¿Por qué esta observación es de grado de investigación?';
      if (/why is this needs review/i.test(q)) return '¿Por qué esta observación necesita revisión?';
      if (/what other observations of this species are nearby/i.test(q)) return '¿Qué otras observaciones de esta especie hay cerca?';
      const tellMe = q.match(/tell me about (.+)\./i);
      if (tellMe) return `Contame sobre ${tellMe[1]}.`;
      const whereMex = q.match(/where in mexico is (.+) typically observed/i);
      if (whereMex) return `¿Dónde en Argentina se suele observar ${whereMex[1]}?`;
      const whereArg = q.match(/where in argentina is (.+) typically observed/i);
      if (whereArg) return `¿Dónde en Argentina se suele observar ${whereArg[1]}?`;
      if (/what does nom-059 .* mean/i.test(q)) return '¿Qué significa su estado de conservación?';
      if (/show me recent observations of this species/i.test(q)) return 'Mostrame observaciones recientes de esta especie.';
      if (/which species are most common in this project/i.test(q)) return '¿Qué especies son más comunes en este proyecto?';
      if (/how many observations were added in the last 30 days/i.test(q)) return '¿Cuántas observaciones se sumaron en los últimos 30 días?';
      if (/list the camera stations in this project/i.test(q)) return 'Listá las estaciones de cámaras de este proyecto.';
      if (/which species have been detected at this station/i.test(q)) return '¿Qué especies se detectaron en esta estación?';
      if (/what is the detection rate per 100 trap-nights/i.test(q)) return '¿Cuál es la tasa de detección por 100 noches-trampa?';
      if (/how long has this station been deployed/i.test(q)) return '¿Cuánto tiempo lleva activa esta estación?';
      const obsMost = q.match(/what species does (.+) observe most/i);
      if (obsMost) return `¿Qué especies observa más ${obsMost[1]}?`;
      if (/when were they most active/i.test(q)) return '¿Cuándo tuvo mayor actividad?';
      if (/what region do they observe in/i.test(q)) return '¿En qué región suele observar?';
      return q;
    }

    function seedSuggestion(card: EntityCardLite): void {
      const ta = document.getElementById('chat-input') as HTMLTextAreaElement | null;
      if (!ta || ta.value || !card.suggested_questions?.[0]) return;
      ta.placeholder = localizeQuestion(card.suggested_questions[0]);
    }

    function showAttachError(msg: string): void {
      const errEl = document.getElementById('chat-attach-error');
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
      setTimeout(() => errEl.classList.add('hidden'), 4000);
    }

    document.addEventListener('rastrum:chat-attach-entity', async (ev) => {
      const detail = (ev as CustomEvent<{ kind: EntityKindLite; id: string; source?: string }>).detail;
      const spec = registry.get(detail.kind);
      if (!spec) return;
      try {
        const card = await spec.fetchCard(detail.id);
        if (!card) {
          showAttachError(isEs ? 'No se encontró ese contexto.' : `Couldn't find that ${detail.kind}.`);
          return;
        }
        attachedEntity = card;
        renderEntityChipFor(card);
        seedSuggestion(card);
        window.dispatchEvent(new CustomEvent('rastrum:onboarding-event', {
          detail: { type: 'chat.entity.attached', kind: card.kind, source: detail.source ?? 'deep-link' },
        }));
      } catch (e) {
        showAttachError(e instanceof Error ? e.message : (isEs ? 'Error al cargar contexto.' : 'Failed to load context.'));
      }
    });

    document.addEventListener('rastrum:chat-detach-entity', () => {
      attachedEntity = null;
      const slot = document.getElementById('chat-entity-chip-slot');
      if (slot) slot.innerHTML = '';
    });

    // Open picker on composer button click.
    document.getElementById('chat-attach-entity-btn')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('rastrum:chat-open-entity-picker'));
    });

    // Handle ?attach= deep-link on page load.
    const { parseAttachQuerystring } = await import('../lib/parse-attach-querystring');
    const params = new URLSearchParams(location.search);
    const parsed = parseAttachQuerystring(params.get('attach'));
    if (parsed) {
      document.dispatchEvent(new CustomEvent('rastrum:chat-attach-entity', {
        detail: { ...parsed, source: 'deep-link' },
      }));
      params.delete('attach');
      const qs = params.toString();
      history.replaceState(null, '', `${location.pathname}${qs ? '?' + qs : ''}`);
    }

    // Expose for the form-submit hook below.
    (window as Window & { __chatGetAttachedEntity?: () => EntityCardLite | null }).__chatGetAttachedEntity = () => attachedEntity;

    // Empty-state suggestion chips: seed the textarea and submit.
    document.querySelectorAll('[data-empty-prompt]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const prompt = (btn as HTMLButtonElement).dataset.emptyPrompt ?? '';
        const ta = document.getElementById('chat-input') as HTMLTextAreaElement | null;
        if (!ta) return;
        ta.value = prompt;
        ta.focus();
        const form = document.getElementById('chat-form') as HTMLFormElement | null;
        form?.requestSubmit();
      });
    });
  })().catch((e) => {
    console.warn('[chat] entity wiring init failed', e);
  });
</script>

<style>
  .chat-chip {
    @apply min-h-11 inline-flex items-center justify-center rounded-full border px-2.5 py-1 leading-none;
  }
  .empty-suggestion {
    @apply inline-flex items-center gap-1.5 rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:border-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors;
  }
</style>
