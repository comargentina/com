---
import { t, getLocalizedPath, routes } from '../i18n/utils';
import ChatHistory from './chat/ChatHistory.astro';
import ChatComposer from './chat/ChatComposer.astro';

interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
const tr = t(lang);
const observePath = getLocalizedPath(lang, routes.observe[lang] + '/');
---

<!-- The chat lays out as full-height with a fixed input bar on small screens.
     `pb-44` reserves room above the sticky composer + the iOS home indicator. -->
<div class="max-w-3xl mx-auto -mt-2 sm:mt-0">
  <!-- Mobile-only sleek header bar: back button + title + Keys button -->
  <div class="sm:hidden flex items-center justify-between py-1 mb-2 border-b border-zinc-200 dark:border-zinc-800">
    <a href={getLocalizedPath(lang, '/')} class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400 py-1">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      <span>{lang === 'es' ? 'Volver' : 'Back'}</span>
    </a>
    <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
      <img src={`${import.meta.env.BASE_URL}com-logo-120.png`} alt="" class="w-4 h-4 rounded-full" />
      <span>COM Chat</span>
    </span>
    <button
      id="chat-toggle-keys-btn-mobile"
      type="button"
      class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-lg bg-amber-100 dark:bg-amber-900/30 text-amber-900 dark:text-amber-200 border border-amber-300 dark:border-amber-700/50"
    >
      <span>🔑</span>
      <span>{lang === 'es' ? 'Claves' : 'Keys'}</span>
    </button>
  </div>

  <div class="mb-2 hidden sm:flex items-baseline justify-between gap-3 flex-wrap">
    <div class="flex items-center gap-2 flex-wrap">
      <h1 class="text-2xl font-bold tracking-tight">{tr.chat.title}</h1>
      <span id="chat-model-badge" class="inline-flex items-center gap-1 rounded-full border border-emerald-300 dark:border-emerald-700/40 bg-emerald-50 dark:bg-emerald-900/10 px-2 py-0.5 text-[10px] font-medium text-emerald-800 dark:text-emerald-300">
        <span aria-hidden="true">✨</span>
        <span id="chat-model-badge-text">{tr.chat.badge.fallback}</span>
      </span>
      <button
        id="chat-toggle-keys-btn"
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-amber-300 dark:border-amber-700/50 bg-amber-50 dark:bg-amber-900/20 px-2.5 py-0.5 text-[11px] font-medium text-amber-900 dark:text-amber-200 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors cursor-pointer"
        title="Configurar claves de API de Google AI Studio"
      >
        <span>🔑</span>
        <span>{lang === 'es' ? 'Configurar claves' : 'Configure keys'}</span>
      </button>
    </div>
    <button
      id="chat-clear-btn"
      type="button"
      class="hidden text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:underline min-h-11 sm:min-h-0"
    >
      {tr.chat.clear}
    </button>
  </div>
  <p class="hidden sm:block text-sm text-zinc-600 dark:text-zinc-300 mb-4">{tr.chat.subtitle}</p>

  <!-- Quota exceeded / BYO key prompt — shown when quota is hit OR when an image is sent without a key -->
  <div id="chat-quota-banner" class="hidden rounded-xl border border-amber-300 dark:border-amber-700/40 bg-amber-50 dark:bg-amber-900/10 p-4 mb-4">
    <div class="flex items-center justify-between gap-2 mb-2">
      <p class="text-sm font-semibold text-amber-900 dark:text-amber-100">
        {lang === 'es'
          ? '🔑 Claves de Google AI Studio (Gemini Flash)'
          : '🔑 Google AI Studio Keys (Gemini Flash)'}
      </p>
      <button
        id="chat-quota-banner-close"
        type="button"
        class="text-xs text-amber-800 dark:text-amber-300 hover:underline"
      >
        ✕
      </button>
    </div>
    <p class="text-xs text-amber-800 dark:text-amber-300/90 mb-3">
      {lang === 'es'
        ? 'La app ya incluye claves integradas para analizar imágenes. Podés agregar tus propias claves para sumar cuota extra. Si la Cuenta 1 se agota, el sistema pasa automáticamente a la Cuenta 2.'
        : 'The app already includes built-in keys for image analysis. You can add your own keys to add extra quota. If Account 1 is exhausted, the system automatically switches to Account 2.'}
    </p>
    <div class="space-y-2.5">
      <div>
        <label for="chat-byo-key-input" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">
          {lang === 'es' ? 'Cuenta 1 (Clave principal):' : 'Account 1 (Primary key):'}
        </label>
        <input
          id="chat-byo-key-input"
          type="password"
          placeholder="AQ... o AIzaSy..."
          autocomplete="off"
          class="w-full min-h-10 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono text-xs"
        />
      </div>
      <div>
        <label for="chat-byo-backup-key-input" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">
          {lang === 'es' ? 'Cuenta 2 (Respaldo opcional — rotación automática al agotar créditos):' : 'Account 2 (Optional backup — auto-failover when quota depleted):'}
        </label>
        <input
          id="chat-byo-backup-key-input"
          type="password"
          placeholder="AQ... o AIzaSy... (opcional)"
          autocomplete="off"
          class="w-full min-h-10 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono text-xs"
        />
      </div>
      <div class="flex items-center justify-between pt-1 flex-wrap gap-2">
        <p class="text-[11px] text-amber-800 dark:text-amber-300/80">
          {lang === 'es'
            ? 'Las claves se guardan solo en tu navegador. Obtenelas en '
            : 'Keys are stored only in your browser. Get them at '}
          <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener" class="underline font-medium">aistudio.google.com/apikey</a>
        </p>
        <button
          id="chat-byo-key-save"
          type="button"
          class="min-h-10 rounded-lg bg-emerald-700 px-4 text-sm font-medium text-white hover:bg-emerald-800 disabled:opacity-50 ml-auto"
        >
          {lang === 'es' ? 'Guardar claves' : 'Save keys'}
        </button>
      </div>
    </div>
  </div>

  <!-- Scrollable message list -->
  <ChatHistory lang={lang} />

  <!-- Sticky composer: textarea + attachment buttons + model picker + dialogs -->
  <ChatComposer lang={lang} observePath={observePath} />
</div>
<script>
  import {
    detectLocaleFromDoc,
    CHAT_SYSTEM_PROMPT,
    type Locale as ChatLocale,
  } from '../lib/local-ai-helpers';
  import {
    buildCascadeInterpretationPrompt,
    buildVisionFallbackPrompt,
    buildPendingObservation,
    buildChatSuggestions,
    pluginIdToObservationSource,
    PENDING_OBSERVATION_KEY,
    type CascadeCandidate,
    type ChatSuggestion,
  } from '../lib/chat-attachment-helpers';
  import {
    appendTurn,
    clearChatHistory,
    defaultStore as defaultChatStore,
    readRecentTurns,
    makeTurnId,
  } from '../lib/chat-history';
  import {
    createSpeechRecognition,
    isSpeechRecognitionSupported,
    speechRecognitionLang,
    type SpeechRecognitionLike,
  } from '../lib/speech-recognition';

  type ChatRole = 'user' | 'assistant';
  interface ChatAttachment {
    kind: 'photo' | 'audio';
    blob: Blob;
    objectUrl: string;
    mimeType: string;
    durationSec?: number;
  }
  interface ChatTurn {
    role: ChatRole;
    content: string;
    attachment?: ChatAttachment;
    /** Cascade result attached to assistant turns that interpret an upload. */
    cascadeResult?: {
      best: CascadeCandidate | null;
      attachmentKind: 'photo' | 'audio';
      attachmentBlobUrl: string;
      attachmentMime: string;
    };
    /** Side-by-side comparison results — one entry per probed model. */
    compareResult?: {
      attachmentKind: 'photo' | 'audio';
      attachmentBlobUrl: string;
      attachmentMime: string;
      entries: Array<{
        id: string;
        name: string;
        ok: boolean;
        result?: CascadeCandidate;
        error?: string;
      }>;
    };
    /** Streaming/loading flag so the bubble can show a spinner placeholder. */
    pending?: boolean;
  }

  // Photo model picker is still used for the cascade identifier choice.
  type ModelPickerChoice =
    | 'auto'
    | 'plantnet'
    | 'claude_haiku'
    | 'webllm_phi35_vision'
    | 'onnx_gemma4_vision'
    | 'onnx_efficientnet_lite0'
    | 'compare';
  const MODEL_PICKER_KEY = 'rastrum.chat.modelPicker';
  function readModelPick(): ModelPickerChoice {
    if (typeof localStorage === 'undefined') return 'auto';
    const v = localStorage.getItem(MODEL_PICKER_KEY) as ModelPickerChoice | null;
    const allowed: ModelPickerChoice[] = ['auto','plantnet','claude_haiku','webllm_phi35_vision','onnx_gemma4_vision','onnx_efficientnet_lite0','compare'];
    return v && allowed.includes(v) ? v : 'auto';
  }
  function writeModelPick(v: ModelPickerChoice): void {
    if (typeof localStorage !== 'undefined') localStorage.setItem(MODEL_PICKER_KEY, v);
  }


  const isEs = (document.documentElement.lang === 'es');
  const docLocale: ChatLocale = detectLocaleFromDoc();

  const i18nBag = document.getElementById('chat-i18n');
  const i18nGet = (k: string) => i18nBag?.dataset[camelize(k)] ?? '';

  const quotaBanner    = document.getElementById('chat-quota-banner');
  const byoKeyInput    = document.getElementById('chat-byo-key-input') as HTMLInputElement | null;
  const byoKeySave     = document.getElementById('chat-byo-key-save') as HTMLButtonElement | null;
  const historyEl      = document.getElementById('chat-history');
  const emptyState     = document.getElementById('chat-empty');
  const formEl         = document.getElementById('chat-form') as HTMLFormElement | null;
  const inputEl        = document.getElementById('chat-input') as HTMLTextAreaElement | null;
  const sendBtn        = document.getElementById('chat-send-btn') as HTMLButtonElement | null;
  const sendLabel      = sendBtn?.querySelector('[data-csl]') as HTMLElement | null;
  const clearBtn       = document.getElementById('chat-clear-btn') as HTMLButtonElement | null;

  const photoBtn       = document.getElementById('chat-photo-btn') as HTMLButtonElement | null;
  const photoInput     = document.getElementById('chat-photo-input') as HTMLInputElement | null;
  const galleryBtn     = document.getElementById('chat-gallery-btn') as HTMLButtonElement | null;
  const galleryInput   = document.getElementById('chat-gallery-input') as HTMLInputElement | null;
  const audioBtn       = document.getElementById('chat-audio-btn') as HTMLButtonElement | null;
  const audioBtnLabel  = audioBtn?.querySelector('[data-audio-label]') as HTMLElement | null;
  const audioElapsedEl = document.getElementById('chat-audio-elapsed');
  const attachChip     = document.getElementById('chat-attachment-chip');
  const attachThumb    = document.getElementById('chat-attachment-thumb');
  const attachLabel    = document.getElementById('chat-attachment-label');
  const attachMeta     = document.getElementById('chat-attachment-meta');
  const attachRemove   = document.getElementById('chat-attachment-remove');
  const attachErr      = document.getElementById('chat-attach-error');
  const modelPickerEl  = document.getElementById('chat-model-picker');
  const visionDialog   = document.getElementById('chat-vision-dialog') as HTMLDialogElement | null;
  const voiceBtn       = document.getElementById('chat-voice-btn') as HTMLButtonElement | null;
  const voiceBtnLabel  = voiceBtn?.querySelector('[data-voice-label]') as HTMLElement | null;
  const chatStore      = defaultChatStore();

  const SEND_DEFAULT = sendLabel?.textContent ?? 'Send';
  const SEND_BUSY    = isEs ? 'Pensando…' : 'Thinking…';

  // Gemini Flash is always ready — no download needed.
  let busy = false;
  const conversation: ChatTurn[] = [];
  let pendingAttachment: ChatAttachment | null = null;


  // Audio recorder state (attachment buttons)
  let mediaRecorder: MediaRecorder | null = null;
  let audioChunks: Blob[] = [];
  let recordStartedAt = 0;
  let elapsedTimer: number | null = null;
  let durationCutoffTimer: number | null = null;
  const AUDIO_MAX_SECS = 30;

  function camelize(s: string): string {
    return s.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
  }

  function escapeHtml(s: string): string {
    return s.replace(/[<>&'"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;',"'":'&#39;','"':'&quot;'}[c]!));
  }

  function paintConversation() {
    if (!historyEl) return;
    if (conversation.length === 0) {
      historyEl.innerHTML = '';
      historyEl.appendChild(emptyState ?? document.createTextNode(''));
      clearBtn?.classList.add('hidden');
      return;
    }
    emptyState?.remove();
    historyEl.innerHTML = conversation.map((t, i) => bubbleHtml(t, i)).join('');
    clearBtn?.classList.remove('hidden');
    wireBubbleActions();
    historyEl.scrollIntoView({ block: 'end', behavior: 'smooth' });
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
  }

  function bubbleHtml(turn: ChatTurn, idx: number): string {
    const isUser = turn.role === 'user';
    const align  = isUser ? 'ml-auto' : 'mr-auto';
    const bg     = isUser
      ? 'bg-emerald-700 text-white'
      : 'bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-800';
    const role   = isUser ? (isEs ? 'Tú' : 'You') : 'COM';

    const attachmentHtml = turn.attachment ? renderAttachmentPreview(turn.attachment) : '';
    const bodyContent = turn.pending
      ? `<span class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-400 italic">
           <svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg>
           ${escapeHtml(turn.content)}
         </span>`
      : escapeHtml(turn.content);
    const cascadeHtml = (!isUser && turn.cascadeResult && !turn.pending) ? renderCascadeFooter(turn, idx) : '';
    const compareHtml = (!isUser && turn.compareResult && !turn.pending) ? renderCompareFooter(turn, idx) : '';
    const suggestionsHtml = (!isUser && !turn.pending && idx === conversation.length - 1)
      ? renderSuggestionChips(turn, idx)
      : '';

    return `
      <div class="${align} max-w-[85%] sm:max-w-[75%]" data-bubble="${idx}">
        <p class="text-[10px] uppercase tracking-wider text-zinc-400 mb-0.5 ${isUser ? 'text-right' : ''}">${escapeHtml(role)}</p>
        <div data-bubble-body class="${bg} rounded-2xl px-3 py-2 text-sm whitespace-pre-wrap break-words">
          ${attachmentHtml}
          <span data-bubble-text>${bodyContent}</span>
        </div>
        ${cascadeHtml}
        ${compareHtml}
        ${suggestionsHtml}
      </div>
    `;
  }

  function renderCompareFooter(turn: ChatTurn, idx: number): string {
    const cr = turn.compareResult;
    if (!cr || cr.entries.length === 0) return '';
    const heading = i18nGet('compare-heading');
    const cards = cr.entries.map((e) => {
      if (e.ok && e.result) {
        const pct = Math.round((e.result.confidence ?? 0) * 100);
        const sci = e.result.scientific_name
          ? `<span class="italic">${escapeHtml(e.result.scientific_name)}</span>`
          : `<span class="text-zinc-600 dark:text-zinc-300">${escapeHtml(i18nGet('compare-no-id'))}</span>`;
        return `
          <li class="rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-2 py-1.5">
            <p class="text-[10px] uppercase tracking-wider text-zinc-600 dark:text-zinc-300 mb-0.5">${escapeHtml(e.name)}</p>
            <p class="text-xs">${sci} <span class="text-[10px] text-zinc-600 dark:text-zinc-300">${pct}%</span></p>
          </li>
        `;
      }
      return `
        <li class="rounded-md border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40 px-2 py-1.5 opacity-70">
          <p class="text-[10px] uppercase tracking-wider text-zinc-600 dark:text-zinc-300 mb-0.5">${escapeHtml(e.name)}</p>
          <p class="text-[11px] text-zinc-600 dark:text-zinc-400">${escapeHtml(e.error ?? i18nGet('compare-unavailable'))}</p>
        </li>
      `;
    }).join('');
    return `
      <div class="mt-2" data-compare="${idx}">
        <p class="text-[10px] uppercase tracking-wider text-zinc-600 dark:text-zinc-300 mb-1">${escapeHtml(heading)}</p>
        <ul class="grid gap-1.5 grid-cols-1 sm:grid-cols-2">${cards}</ul>
      </div>
    `;
  }

  function renderSuggestionChips(turn: ChatTurn, idx: number): string {
    const best = turn.cascadeResult?.best ?? null;
    const commonName = best
      ? (isEs ? best.common_name_es ?? best.common_name_en ?? null : best.common_name_en ?? best.common_name_es ?? null)
      : null;
    const suggestions = buildChatSuggestions({
      locale: docLocale,
      scientificName: best?.scientific_name ?? null,
      commonName,
    });
    const label = i18nGet('suggestions-label');
    const chips = suggestions.map((s, sIdx) => `
      <button
        type="button"
        data-suggestion="${idx}"
        data-suggestion-idx="${sIdx}"
        class="inline-flex items-center min-h-9 rounded-full border border-sky-300 dark:border-sky-700/60 bg-sky-50 dark:bg-sky-900/20 px-3 py-1 text-xs font-medium text-sky-800 dark:text-sky-200 hover:bg-sky-100 dark:hover:bg-sky-900/40"
      >${escapeHtml(s.label)}</button>
    `).join('');
    return `
      <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="${escapeHtml(label)}">
        ${chips}
      </div>
    `;
  }

  /** All suggestions surfaced for the latest assistant turn — kept in sync with the rendered chip set. */
  function suggestionsForTurn(turn: ChatTurn): ChatSuggestion[] {
    const best = turn.cascadeResult?.best ?? null;
    const commonName = best
      ? (isEs ? best.common_name_es ?? best.common_name_en ?? null : best.common_name_en ?? best.common_name_es ?? null)
      : null;
    return buildChatSuggestions({
      locale: docLocale,
      scientificName: best?.scientific_name ?? null,
      commonName,
    });
  }

  function renderAttachmentPreview(att: ChatAttachment): string {
    if (att.kind === 'photo') {
      return `<img src="${escapeHtml(att.objectUrl)}" alt="" class="block max-w-full max-h-64 rounded-md mb-1" />`;
    }
    const dur = att.durationSec != null ? `${att.durationSec.toFixed(1)}s · ` : '';
    return `<audio controls src="${escapeHtml(att.objectUrl)}" class="block w-full max-w-xs mb-1 h-9"></audio>
            <p class="text-[10px] text-zinc-600 dark:text-zinc-300 mb-1">${dur}${escapeHtml(att.mimeType)}</p>`;
  }

  function renderCascadeFooter(turn: ChatTurn, idx: number): string {
    const cr = turn.cascadeResult;
    if (!cr || !cr.best) return '';
    const best = cr.best;
    const pct = Math.round((best.confidence ?? 0) * 100);
    const sciHtml = best.scientific_name ? `<span class="italic font-medium">${escapeHtml(best.scientific_name)}</span>` : '';
    const sourceHtml = `<span class="text-[10px] text-zinc-600 dark:text-zinc-300">${pct}% · ${escapeHtml(best.source)}</span>`;
    const saveLabel = i18nGet('save-as-observation');
    return `
      <div class="mt-1 flex items-center gap-2 flex-wrap">
        ${sciHtml}
        ${sourceHtml}
        <button data-save-obs="${idx}" type="button"
          class="ml-auto inline-flex items-center min-h-9 rounded-lg border border-emerald-600/60 px-3 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20">
          + ${escapeHtml(saveLabel)}
        </button>
      </div>
    `;
  }

  function wireBubbleActions() {
    historyEl?.querySelectorAll<HTMLButtonElement>('button[data-save-obs]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.saveObs);
        const turn = conversation[idx];
        if (!turn?.cascadeResult) return;
        const best = turn.cascadeResult.best;
        const payload = buildPendingObservation({
          blob_url: turn.cascadeResult.attachmentBlobUrl,
          mime_type: turn.cascadeResult.attachmentMime,
          scientific_name: best?.scientific_name ?? '',
          confidence: best?.confidence ?? 0,
          source: best ? pluginIdToObservationSource(best.source) : 'human',
          common_name: best ? (isEs ? best.common_name_es ?? best.common_name_en ?? null : best.common_name_en ?? best.common_name_es ?? null) : null,
          kind: turn.cascadeResult.attachmentKind,
        });
        try { sessionStorage.setItem(PENDING_OBSERVATION_KEY, payload); } catch { /* private mode */ }
        const observePath = i18nGet('observe-path') || (isEs ? '/es/observar/' : '/en/observe/');
        window.location.href = observePath;
      });
    });

    historyEl?.querySelectorAll<HTMLButtonElement>('button[data-suggestion]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.suggestion);
        const sIdx = Number(btn.dataset.suggestionIdx);
        const turn = conversation[idx];
        if (!turn) return;
        const suggestions = suggestionsForTurn(turn);
        const choice = suggestions[sIdx];
        if (!choice || !inputEl) return;
        inputEl.value = choice.prompt;
        autosize();
        formEl?.requestSubmit();
      });
    });
  }

  function setBubbleStreaming(idx: number, content: string) {
    const wrap = historyEl?.querySelector(`[data-bubble="${idx}"] [data-bubble-text]`);
    if (wrap) wrap.textContent = content;
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'auto' });
  }

  function autosize() {
    if (!inputEl) return;
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 160) + 'px';
  }

  // ── Attachment chip ──
  function clearAttachmentChip() {
    if (pendingAttachment?.objectUrl) URL.revokeObjectURL(pendingAttachment.objectUrl);
    pendingAttachment = null;
    attachChip?.classList.add('hidden');
    modelPickerEl?.classList.add('hidden');
    if (attachThumb) attachThumb.innerHTML = '';
    if (attachLabel) attachLabel.textContent = '';
    if (attachMeta) attachMeta.textContent = '';
  }

  function setAttachment(kind: 'photo' | 'audio', blob: Blob, durationSec?: number) {
    if (pendingAttachment?.objectUrl) URL.revokeObjectURL(pendingAttachment.objectUrl);
    const objectUrl = URL.createObjectURL(blob);
    const mimeType = blob.type || (kind === 'photo' ? 'image/jpeg' : 'audio/webm');
    pendingAttachment = { kind, blob, objectUrl, mimeType, durationSec };
    if (!attachChip || !attachThumb || !attachLabel || !attachMeta) return;
    attachChip.classList.remove('hidden');
    // Picker is photo-only — for audio there's no choice to make (BirdNET).
    if (kind === 'photo') {
      modelPickerEl?.classList.remove('hidden');
    } else {
      modelPickerEl?.classList.add('hidden');
    }
    if (kind === 'photo') {
      attachThumb.innerHTML = `<img src="${escapeHtml(objectUrl)}" alt="" class="w-full h-full object-cover" />`;
      attachLabel.textContent = i18nGet('attach-photo-label');
      attachMeta.textContent = mimeType;
    } else {
