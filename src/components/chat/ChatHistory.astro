---
/**
 * ChatHistory.astro — scrollable chat message list, extracted from ChatView.astro (#913)
 *
 * Owns the #chat-history log region and the empty-state display with suggestion
 * quick-prompt chips. ChatView's paintConversation() script populates this
 * container with bubbleHtml() calls at runtime.
 *
 * CustomEvents dispatched by chips → consumed by ChatView's entity bootstrap:
 *   - <button data-empty-prompt="…"> clicks are wired by ChatView's entity IIFE
 */

interface Props {
  lang: 'en' | 'es';
}

import { t } from '../../i18n/utils';
const { lang } = Astro.props;
const tr = t(lang);
---
<!-- Conversation log — populated by ChatView's paintConversation() at runtime -->
<div
  id="chat-history"
  class="space-y-3 mb-4 pb-56 sm:pb-4"
  role="log"
  aria-live="polite"
>
  <div id="chat-empty" class="px-1 py-12 text-center space-y-4">
    <p class="text-sm text-zinc-600 dark:text-zinc-300 italic">{tr.chat.empty_state}</p>
    {/* Sugerencias rápidas deshabilitadas temporalmente por preferencia de UI. Descomentar para reactivar:
    <div class="flex flex-wrap justify-center gap-2 max-w-xl mx-auto">
      <button type="button" data-empty-prompt={lang === 'es' ? '¿Qué especies puedo encontrar cerca de mí?' : 'What species can I find near me?'} class="empty-suggestion">
        <span aria-hidden="true">📍</span>
        <span>{lang === 'es' ? 'Cerca de mí' : 'Near me'}</span>
      </button>
      <button type="button" data-empty-prompt={lang === 'es' ? 'Adjunta una observación reciente para revisarla.' : 'Attach a recent observation to review it.'} class="empty-suggestion">
        <span aria-hidden="true">🔍</span>
        <span>{lang === 'es' ? 'Revisar observación' : 'Review observation'}</span>
      </button>
      <button type="button" data-empty-prompt={lang === 'es' ? '¿Cuándo una observación es primaria?' : 'When is an observation considered primary?'} class="empty-suggestion">
        <span aria-hidden="true">⭐</span>
        <span>{lang === 'es' ? 'Observación primaria' : 'Primary observation'}</span>
      </button>
      <button type="button" data-empty-prompt={lang === 'es' ? '¿Cuál es el estado de conservación de esta especie según la UICN y Argentina?' : 'What is the conservation status of this species according to IUCN and Argentina?'} class="empty-suggestion">
        <span aria-hidden="true">🛡️</span>
        <span>{lang === 'es' ? 'Conservación' : 'Conservation'}</span>
      </button>
    </div>
    */}
  </div>
</div>
