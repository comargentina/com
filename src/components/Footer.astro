---
import { t, getLocalizedPath, getDocPath, getAlternateUrl, routes, type Locale } from '../i18n/utils';
import { resolveChromeMode } from '../lib/chrome-mode';

interface Props {
  lang: string;
  currentPath?: string;
}

const { lang, currentPath = '' } = Astro.props;
const chromeMode = resolveChromeMode(currentPath, import.meta.env.BASE_URL);
if (chromeMode === 'app') return;

const appVersion = import.meta.env.PUBLIC_VERSION ?? 'dev';

const tr = t(lang);
const trEn = t('en');
const trEs = t('es');
const locale = (lang === 'es' ? 'es' : 'en') as Locale;
const alt: Locale = locale === 'es' ? 'en' : 'es';
const altHref = currentPath ? getAlternateUrl(currentPath, alt) : getLocalizedPath(alt, '/');
const enHref  = currentPath ? getAlternateUrl(currentPath, 'en') : getLocalizedPath('en', '/');

const year = new Date().getFullYear();

const observeHrefEn      = getLocalizedPath('en', routes.observe.en + '/');
const observeHrefEs      = getLocalizedPath('es', routes.observe.es + '/');
const identifyHrefEn     = getLocalizedPath('en', routes.identify.en + '/');
const identifyHrefEs     = getLocalizedPath('es', routes.identify.es + '/');
const exploreHrefEn      = getLocalizedPath('en', routes.exploreMap.en + '/');
const exploreHrefEs      = getLocalizedPath('es', routes.exploreMap.es + '/');
const chatHrefEn         = getLocalizedPath('en', routes.chat.en + '/');
const chatHrefEs         = getLocalizedPath('es', routes.chat.es + '/');

const aboutHrefEn        = getLocalizedPath('en', routes.about.en + '/');
const aboutHrefEs        = getLocalizedPath('es', routes.about.es + '/');
const visionHrefEn       = getDocPath('en', 'vision');
const visionHrefEs       = getDocPath('es', 'vision');
const roadmapHrefEn      = getDocPath('en', 'roadmap');
const roadmapHrefEs      = getDocPath('es', 'roadmap');
const architectureHrefEn = getDocPath('en', 'architecture');
const architectureHrefEs = getDocPath('es', 'architecture');
const contributeHrefEn   = getDocPath('en', 'contribute');
const contributeHrefEs   = getDocPath('es', 'contribute');

const privacyHrefEn = getLocalizedPath('en', routes.privacy.en + '/');
const privacyHrefEs = getLocalizedPath('es', routes.privacy.es + '/');
const termsHrefEn   = getLocalizedPath('en', routes.terms.en + '/');
const termsHrefEs   = getLocalizedPath('es', routes.terms.es + '/');
const faqHrefEn     = getLocalizedPath('en', routes.faq.en + '/');
const faqHrefEs     = getLocalizedPath('es', routes.faq.es + '/');

const observeHref      = lang === 'es' ? observeHrefEs : observeHrefEn;
const identifyHref     = lang === 'es' ? identifyHrefEs : identifyHrefEn;
const exploreHref      = lang === 'es' ? exploreHrefEs : exploreHrefEn;
const chatHref         = lang === 'es' ? chatHrefEs : chatHrefEn;
const aboutHref        = lang === 'es' ? aboutHrefEs : aboutHrefEn;
const visionHref       = lang === 'es' ? visionHrefEs : visionHrefEn;
const roadmapHref      = lang === 'es' ? roadmapHrefEs : roadmapHrefEn;
const architectureHref = lang === 'es' ? architectureHrefEs : architectureHrefEn;
const contributeHref   = lang === 'es' ? contributeHrefEs : contributeHrefEn;
const privacyHref      = lang === 'es' ? privacyHrefEs : privacyHrefEn;
const termsHref        = lang === 'es' ? termsHrefEs : termsHrefEn;
const faqHref          = lang === 'es' ? faqHrefEs : faqHrefEn;

const ftLinks = tr.footer.links as Record<string, string>;
const ftCols  = tr.footer.columns as Record<string, string>;
const ftLinksEn = trEn.footer.links as Record<string, string>;
const ftColsEn  = trEn.footer.columns as Record<string, string>;
const ftLinksEs = trEs.footer.links as Record<string, string>;
const ftColsEs  = trEs.footer.columns as Record<string, string>;

const linkClass = 'text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors';
const mLinkClass = 'text-zinc-600 dark:text-zinc-400';
---

<footer class="border-t border-zinc-200 dark:border-zinc-800 mt-16 bg-white dark:bg-zinc-950">
  <div class="max-w-6xl mx-auto px-4 pt-10 pb-6">

    <!-- ── Desktop grid (sm+): brand spans 2 of 5 cols on lg; 2-col on md/sm ── -->
    <div class="hidden sm:grid sm:grid-cols-2 lg:grid-cols-5 gap-8">

      <!-- Brand: spans 2 cols on lg -->
      <div class="sm:col-span-2 lg:col-span-2 space-y-3">
        <a href={getLocalizedPath(lang, '/')}
           data-href-en={getLocalizedPath('en', '/')}
           data-href-es={getLocalizedPath('es', '/')}
           class="inline-flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-lg">
          <img src="/com-logo.jpg" alt="COM Logo" class="w-8 h-8 rounded-full object-cover" width="32" height="32" loading="lazy" />
          COM Argentina
        </a>
        <p class="text-sm text-zinc-600 dark:text-zinc-400"
           data-i18n data-en={trEn.footer.tagline} data-es={trEs.footer.tagline}>{tr.footer.tagline}</p>
        <p class="text-xs text-zinc-400 dark:text-zinc-300 max-w-xs"
           data-i18n data-en={trEn.footer.description_short} data-es={trEs.footer.description_short}>{tr.footer.description_short}</p>
        <div class="flex items-center gap-4 pt-1 text-xs">
          <a href="#" class={linkClass} data-i18n data-en={ftLinksEn.mastodon} data-es={ftLinksEs.mastodon}>{ftLinks.mastodon}</a>
          <a href="#" class={linkClass} data-i18n data-en={ftLinksEn.rss} data-es={ftLinksEs.rss}>{ftLinks.rss}</a>
        </div>
      </div>

      <!-- Product -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider"
            data-i18n data-en={ftColsEn.product} data-es={ftColsEs.product}>{ftCols.product}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={observeHref} data-href-en={observeHrefEn} data-href-es={observeHrefEs} class={linkClass} data-i18n data-en={trEn.nav.observe} data-es={trEs.nav.observe}>{tr.nav.observe}</a></li>
          <li><a href={identifyHref} data-href-en={identifyHrefEn} data-href-es={identifyHrefEs} class={linkClass} data-i18n data-en={trEn.nav.identify} data-es={trEs.nav.identify}>{tr.nav.identify}</a></li>
          <li><a href={exploreHref} data-href-en={exploreHrefEn} data-href-es={exploreHrefEs} class={linkClass} data-i18n data-en={trEn.nav.map} data-es={trEs.nav.map}>{tr.nav.map}</a></li>
          <li><a href={chatHref} data-href-en={chatHrefEn} data-href-es={chatHrefEs} class={linkClass} data-i18n data-en={trEn.nav.chat} data-es={trEs.nav.chat}>{tr.nav.chat}</a></li>
        </ul>
      </div>

      <!-- Learn -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider"
            data-i18n data-en={ftColsEn.learn} data-es={ftColsEs.learn}>{ftCols.learn}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={aboutHref} data-href-en={aboutHrefEn} data-href-es={aboutHrefEs} class={linkClass} data-i18n data-en={trEn.nav.about} data-es={trEs.nav.about}>{tr.nav.about}</a></li>
          <li><a href={visionHref} data-href-en={visionHrefEn} data-href-es={visionHrefEs} class={linkClass} data-i18n data-en={trEn.docs.sections.vision} data-es={trEs.docs.sections.vision}>{tr.docs.sections.vision}</a></li>
          <li><a href={roadmapHref} data-href-en={roadmapHrefEn} data-href-es={roadmapHrefEs} class={linkClass} data-i18n data-en={trEn.docs.sections.roadmap} data-es={trEs.docs.sections.roadmap}>{tr.docs.sections.roadmap}</a></li>
          <li><a href={architectureHref} data-href-en={architectureHrefEn} data-href-es={architectureHrefEs} class={linkClass} data-i18n data-en={trEn.docs.sections.architecture} data-es={trEs.docs.sections.architecture}>{tr.docs.sections.architecture}</a></li>
        </ul>
      </div>

      <!-- Community -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider"
            data-i18n data-en={ftColsEn.community} data-es={ftColsEs.community}>{ftCols.community}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={contributeHref} data-href-en={contributeHrefEn} data-href-es={contributeHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.contribute} data-es={ftLinksEs.contribute}>{ftLinks.contribute}</a></li>
        </ul>
      </div>

      <!-- Legal (lg: 5th col; hidden on sm/md, shown inline in bottom strip) -->
      <div class="hidden lg:block space-y-3">
        <h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider"
            data-i18n data-en={ftColsEn.legal} data-es={ftColsEs.legal}>{ftCols.legal}</h3>
        <ul class="space-y-2 text-sm">
          <li><span class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={trEn.footer.license} data-es={trEs.footer.license}>{tr.footer.license}</span></li>
          <li><a href={privacyHref} data-href-en={privacyHrefEn} data-href-es={privacyHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.privacy} data-es={ftLinksEs.privacy}>{ftLinks.privacy}</a></li>
          <li><a href={termsHref} data-href-en={termsHrefEn} data-href-es={termsHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.terms} data-es={ftLinksEs.terms}>{ftLinks.terms}</a></li>
          <li><a href={faqHref} data-href-en={faqHrefEn} data-href-es={faqHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.faq} data-es={ftLinksEs.faq}>{ftLinks.faq}</a></li>
        </ul>
      </div>

    </div>

    <!-- Legal row: sm/md only (between grid and bottom strip) -->
    <div class="hidden sm:flex lg:hidden items-center gap-x-4 gap-y-2 flex-wrap mt-6 text-sm">
      <span class="text-zinc-600 dark:text-zinc-400" data-i18n data-en={trEn.footer.license} data-es={trEs.footer.license}>{tr.footer.license}</span>
      <a href={privacyHref} data-href-en={privacyHrefEn} data-href-es={privacyHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.privacy} data-es={ftLinksEs.privacy}>{ftLinks.privacy}</a>
      <a href={termsHref} data-href-en={termsHrefEn} data-href-es={termsHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.terms} data-es={ftLinksEs.terms}>{ftLinks.terms}</a>
      <a href={faqHref} data-href-en={faqHrefEn} data-href-es={faqHrefEs} class={linkClass} data-i18n data-en={ftLinksEn.faq} data-es={ftLinksEs.faq}>{ftLinks.faq}</a>
    </div>

    <!-- ── Mobile: brand + 4 <details> accordions ── -->
    <div class="sm:hidden space-y-4">
      <div class="space-y-2">
        <a href={getLocalizedPath(lang, '/')}
           data-href-en={getLocalizedPath('en', '/')}
           data-href-es={getLocalizedPath('es', '/')}
           class="inline-flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold">
          <img src="/com-logo.jpg" alt="" class="w-5 h-5 rounded-full object-cover" width="20" height="20" loading="lazy" />
          COM Argentina
        </a>
        <p class="text-xs text-zinc-400 dark:text-zinc-300"
           data-i18n data-en={trEn.footer.tagline} data-es={trEs.footer.tagline}>{tr.footer.tagline}</p>
        <div class="flex items-center gap-3 text-xs">
          <a href="#" class={mLinkClass} data-i18n data-en={ftLinksEn.mastodon} data-es={ftLinksEs.mastodon}>{ftLinks.mastodon}</a>
          <a href="#" class={mLinkClass} data-i18n data-en={ftLinksEn.rss} data-es={ftLinksEs.rss}>{ftLinks.rss}</a>
        </div>
      </div>

      {[
        { label: ftCols.product, labelEn: ftColsEn.product, labelEs: ftColsEs.product, items: [
          { href: observeHref, hrefEn: observeHrefEn, hrefEs: observeHrefEs, label: tr.nav.observe, labelEn: trEn.nav.observe, labelEs: trEs.nav.observe },
          { href: identifyHref, hrefEn: identifyHrefEn, hrefEs: identifyHrefEs, label: tr.nav.identify, labelEn: trEn.nav.identify, labelEs: trEs.nav.identify },
          { href: exploreHref, hrefEn: exploreHrefEn, hrefEs: exploreHrefEs, label: tr.nav.map, labelEn: trEn.nav.map, labelEs: trEs.nav.map },
          { href: chatHref, hrefEn: chatHrefEn, hrefEs: chatHrefEs, label: tr.nav.chat, labelEn: trEn.nav.chat, labelEs: trEs.nav.chat },
        ]},
        { label: ftCols.learn, labelEn: ftColsEn.learn, labelEs: ftColsEs.learn, items: [
          { href: aboutHref, hrefEn: aboutHrefEn, hrefEs: aboutHrefEs, label: tr.nav.about, labelEn: trEn.nav.about, labelEs: trEs.nav.about },
          { href: visionHref, hrefEn: visionHrefEn, hrefEs: visionHrefEs, label: tr.docs.sections.vision, labelEn: trEn.docs.sections.vision, labelEs: trEs.docs.sections.vision },
          { href: roadmapHref, hrefEn: roadmapHrefEn, hrefEs: roadmapHrefEs, label: tr.docs.sections.roadmap, labelEn: trEn.docs.sections.roadmap, labelEs: trEs.docs.sections.roadmap },
          { href: architectureHref, hrefEn: architectureHrefEn, hrefEs: architectureHrefEs, label: tr.docs.sections.architecture, labelEn: trEn.docs.sections.architecture, labelEs: trEs.docs.sections.architecture },
        ]},
        { label: ftCols.community, labelEn: ftColsEn.community, labelEs: ftColsEs.community, items: [
          { href: contributeHref, hrefEn: contributeHrefEn, hrefEs: contributeHrefEs, label: ftLinks.contribute, labelEn: ftLinksEn.contribute, labelEs: ftLinksEs.contribute },
        ]},
        { label: ftCols.legal, labelEn: ftColsEn.legal, labelEs: ftColsEs.legal, items: [
          { href: privacyHref, hrefEn: privacyHrefEn, hrefEs: privacyHrefEs, label: ftLinks.privacy, labelEn: ftLinksEn.privacy, labelEs: ftLinksEs.privacy },
          { href: termsHref, hrefEn: termsHrefEn, hrefEs: termsHrefEs, label: ftLinks.terms, labelEn: ftLinksEn.terms, labelEs: ftLinksEs.terms },
          { href: faqHref, hrefEn: faqHrefEn, hrefEs: faqHrefEs, label: ftLinks.faq, labelEn: ftLinksEn.faq, labelEs: ftLinksEs.faq },
        ]},
      ].map(col => (
        <details class="group border-t border-zinc-100 dark:border-zinc-800 pt-3">
          <summary class="flex items-center justify-between cursor-pointer list-none text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">
            <span data-i18n data-en={col.labelEn} data-es={col.labelEs}>{col.label}</span>
            <svg aria-hidden="true" class="w-3 h-3 transition-transform group-open:rotate-90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </summary>
          <ul class="mt-2 space-y-2 text-sm pb-1">
            {col.items.map(item => (
              <li><a href={item.href} data-href-en={item.hrefEn} data-href-es={item.hrefEs} class={mLinkClass} data-i18n data-en={item.labelEn} data-es={item.labelEs}>{item.label}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </div>

    <!-- ── Bottom strip ── -->
    <div class="mt-8 pt-5 border-t border-zinc-100 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-3 pb-[env(safe-area-inset-bottom,0px)]">
      <p class="text-xs text-zinc-400 dark:text-zinc-300 text-center sm:text-left">
        &copy; {year} COM &middot; <span data-i18n data-en={ftLinksEn.license_summary} data-es={ftLinksEs.license_summary}>{ftLinks.license_summary}</span>
      </p>
      <div class="flex items-center gap-2">
        <!-- EN/ES segmented switch -->
        <div class="flex items-center rounded border border-zinc-300 dark:border-zinc-700 text-xs overflow-hidden" role="group" aria-label="Language">
          <a
            href={enHref}
            data-lang-switch="en"
            class={`px-2 py-1 transition-colors ${locale === 'en' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-medium' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300'}`}
          >EN</a>
          <span class="border-l border-zinc-300 dark:border-zinc-700 self-stretch" aria-hidden="true"></span>
          <a
            href={altHref}
            data-lang-switch="es"
            class={`px-2 py-1 transition-colors ${locale === 'es' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-medium' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300'}`}
          >ES</a>
        </div>
        <!-- Theme switch -->
        <button
          id="footer-theme-toggle"
          class="p-1.5 rounded border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
          aria-label={tr.nav.drawer.toggle_theme}
        >
          <svg aria-hidden="true" class="w-3.5 h-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg aria-hidden="true" class="w-3.5 h-3.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <!-- Version stamp -->
        <span class="text-xs text-zinc-400 dark:text-zinc-300 font-mono">v{appVersion}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  const themeBtn = document.getElementById('footer-theme-toggle');
  themeBtn?.addEventListener('click', () => {
    document.documentElement.classList.remove('field');
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });

  window.addEventListener('rastrum:lang-change', (e: any) => {
    const target = e.detail?.lang;
    if (!target) return;
    document.querySelectorAll('[data-lang-switch]').forEach(btn => {
      const btnTarget = (btn as HTMLElement).dataset.langSwitch;
      const isActive = btnTarget === target;
      btn.classList.toggle('bg-zinc-100', isActive);
      btn.classList.toggle('dark:bg-zinc-800', isActive);
      btn.classList.toggle('font-medium', isActive);
    });
    document.querySelectorAll('[data-href-en][data-href-es]').forEach(node => {
      const href = node.getAttribute('data-href-' + target);
      if (href) (node as HTMLAnchorElement).href = href;
    });
  });

  document.querySelectorAll('[data-lang-switch]').forEach(el => {
    el.addEventListener('click', (e) => {
      const target = (el as HTMLElement).dataset.langSwitch;
      if (target) {
        localStorage.setItem('rastrum.lang', target);
        // On locale-neutral paths (no /en/ or /es/ prefix) the href points to
        // the same URL, so navigation won't reload the page. Trigger applyLang
        // directly so data-i18n elements switch immediately.
        const path = window.location.pathname;
        const isLocaleless = !path.startsWith('/en/') && !path.startsWith('/es/');
        if (isLocaleless) {
          e.preventDefault();
          document.documentElement.lang = target;
          document.querySelectorAll('[data-i18n]').forEach(node => {
            const text = node.getAttribute('data-' + target);
            if (text) node.textContent = text;
          });
          document.querySelectorAll('[data-i18n-placeholder]').forEach(node => {
            const ph = node.getAttribute('data-' + target + '-placeholder');
            if (ph) (node as HTMLInputElement).placeholder = ph;
          });
          document.querySelectorAll('[data-href-en][data-href-es]').forEach(node => {
            const href = node.getAttribute('data-href-' + target);
            if (href) (node as HTMLAnchorElement).href = href;
          });
          // Update active state on lang buttons
          document.querySelectorAll('[data-lang-switch]').forEach(btn => {
            const btnTarget = (btn as HTMLElement).dataset.langSwitch;
            const isActive = btnTarget === target;
            btn.classList.toggle('bg-zinc-100', isActive);
            btn.classList.toggle('dark:bg-zinc-800', isActive);
            btn.classList.toggle('font-medium', isActive);
          });
          window.dispatchEvent(new CustomEvent('rastrum:lang-change', { detail: { lang: target } }));
        }
      }
    });
  });
</script>
