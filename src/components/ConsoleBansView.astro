---
/**
 * ConsoleBansView — master-detail ban list with issue-ban affordance and
 * unban action. Gate: moderator OR admin.
 */
import { t } from '../i18n/utils';
import ConsoleSlideOver from './ConsoleSlideOver.astro';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const tr = t(lang);
---

<section class="max-w-6xl">
  <div id="bans-not-auth" class="hidden rounded border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-900/20 p-3 text-sm text-amber-900 dark:text-amber-100">
    {tr.console.not_authorized}
  </div>

  <div id="bans-shell" class="hidden">
    <p class="mb-4 text-sm text-zinc-600 dark:text-zinc-400">{tr.console.bans_intro}</p>

    <!-- Top row: filter toggle + issue ban -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <div class="flex rounded border border-zinc-300 dark:border-zinc-700 overflow-hidden text-sm">
        <button id="bans-toggle-active" class="px-3 py-1.5 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-medium">
          {tr.console.bans_filter_active}
        </button>
        <button id="bans-toggle-all" class="px-3 py-1.5 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
          {tr.console.bans_filter_all}
        </button>
      </div>

      <button id="bans-open-issue" class="ml-auto px-3 py-1.5 rounded bg-red-600 hover:bg-red-700 text-white text-sm font-medium">
        {tr.console.bans_chip_ban}
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[320px_1fr] gap-4 h-[calc(100vh-230px)]">
      <!-- Left: ban list -->
      <aside class="flex flex-col border border-zinc-200 dark:border-zinc-800 rounded-lg overflow-hidden">
        <div id="bans-list-loading" class="p-3 text-sm text-zinc-600 dark:text-zinc-300 italic">{tr.console.bans_loading}</div>
        <div id="bans-list-empty" class="hidden p-3 text-sm text-zinc-600 dark:text-zinc-300">{tr.console.bans_empty}</div>
        <ul id="bans-list" class="hidden flex-1 overflow-y-auto divide-y divide-zinc-100 dark:divide-zinc-800"></ul>
      </aside>

      <!-- Right: ban detail -->
      <div id="bans-detail-empty" class="flex items-center justify-center text-sm text-zinc-600 dark:text-zinc-400 border border-dashed border-zinc-200 dark:border-zinc-700 rounded-lg">
        {tr.console.bans_select_prompt}
      </div>
      <div id="bans-detail" class="hidden border border-zinc-200 dark:border-zinc-800 rounded-lg p-4 overflow-y-auto space-y-4">
        <!-- User summary card -->
        <div id="bans-detail-user-card" class="flex items-center gap-3 p-3 rounded-lg bg-zinc-50 dark:bg-zinc-800/50">
          <img id="bans-detail-avatar" src="" alt="" class="w-10 h-10 rounded-full object-cover hidden" />
          <div id="bans-detail-avatar-placeholder" class="w-10 h-10 rounded-full bg-zinc-300 dark:bg-zinc-600 flex items-center justify-center text-zinc-500 dark:text-zinc-300 text-lg font-bold">?</div>
          <div class="min-w-0">
            <p id="bans-detail-display-name" class="font-semibold text-zinc-800 dark:text-zinc-200 truncate"></p>
            <p id="bans-detail-username" class="text-xs text-zinc-500 dark:text-zinc-400 truncate"></p>
            <p id="bans-detail-uid" class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 truncate"></p>
          </div>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
          <dt class="text-zinc-600 dark:text-zinc-300">{tr.console.bans_col_reason}</dt>
          <dd id="bans-detail-reason" class="font-medium text-zinc-800 dark:text-zinc-200"></dd>

          <dt class="text-zinc-600 dark:text-zinc-300">{tr.console.bans_col_expires}</dt>
          <dd id="bans-detail-expires" class="font-medium text-zinc-800 dark:text-zinc-200"></dd>

          <dt class="text-zinc-600 dark:text-zinc-300">{tr.console.bans_col_banned_by}</dt>
          <dd id="bans-detail-banned-by" class="font-medium text-zinc-800 dark:text-zinc-200 text-xs break-all"></dd>

          <dt class="text-zinc-600 dark:text-zinc-300">{tr.console.bans_col_created}</dt>
          <dd id="bans-detail-created" class="font-medium text-zinc-800 dark:text-zinc-200"></dd>
        </dl>

        <div id="bans-detail-revoked-row" class="hidden space-y-1 text-sm">
          <p><span class="text-zinc-600">{tr.console.bans_revoked_label}:</span> <span id="bans-detail-revoked-at" class="font-medium text-zinc-800 dark:text-zinc-200"></span></p>
          <p id="bans-detail-revoke-reason-row" class="hidden"><span class="text-zinc-600">{tr.console.bans_revoke_reason_label}:</span> <span id="bans-detail-revoke-reason" class="text-zinc-700 dark:text-zinc-300 italic"></span></p>
        </div>

        <!-- Action chip: unban -->
        <div>
          <button id="bans-action-unban" class="px-3 py-1.5 rounded text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-200">
            {tr.console.bans_chip_unban}
          </button>
        </div>
      </div>
    </div>
  </div>

  <p id="bans-error" class="hidden mt-3 text-sm text-red-600 dark:text-red-400"></p>
</section>

<!-- Unban slide-over -->
<ConsoleSlideOver
  lang={lang}
  id="console-slideover-bans"
  titleKey={tr.console.bans_action_unban}
  reasonTemplates={[
    tr.console.reason_spam,
    tr.console.reason_harassment,
    tr.console.reason_multiple_policy_violations,
    tr.console.reason_nom059_breach,
    tr.console.quick_reason_custom,
  ]}
/>

<!-- Issue ban slide-over -->
<ConsoleSlideOver
  lang={lang}
  id="console-slideover-bans-issue"
  titleKey={tr.console.bans_ban_user_heading}
  irreversible={true}
  reasonTemplates={[
    tr.console.reason_spam,
    tr.console.reason_harassment,
    tr.console.reason_multiple_policy_violations,
    tr.console.reason_nom059_breach,
    tr.console.quick_reason_custom,
  ]}
>
  <!-- User search -->
  <div class="space-y-2">
    <label class="block text-sm">
      <span class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">{tr.console.bans_search_user_label}</span>
      <div class="flex gap-2">
        <input id="bans-issue-search" type="text"
          class="flex-1 rounded border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-2 py-1.5 text-sm"
          placeholder={tr.console.bans_search_placeholder} />
        <button id="bans-issue-search-btn" type="button"
          class="px-3 py-1.5 rounded bg-zinc-700 dark:bg-zinc-600 text-white text-sm hover:bg-zinc-800">
          {tr.console.bans_search_btn}
        </button>
      </div>
    </label>
    <!-- Found user preview -->
    <div id="bans-issue-user-preview" class="hidden flex items-center gap-2 p-2 rounded bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">
      <img id="bans-issue-avatar" src="" alt="" class="w-8 h-8 rounded-full object-cover hidden" />
      <div id="bans-issue-avatar-ph" class="w-8 h-8 rounded-full bg-zinc-300 dark:bg-zinc-600 flex items-center justify-center text-sm font-bold text-zinc-500 dark:text-zinc-300">?</div>
      <div class="min-w-0">
        <p id="bans-issue-found-name" class="text-sm font-medium text-zinc-800 dark:text-zinc-200 truncate"></p>
        <p id="bans-issue-found-uid" class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 truncate"></p>
      </div>
    </div>
    <p id="bans-issue-not-found" class="hidden text-xs text-red-500 dark:text-red-400">{tr.console.bans_user_not_found}</p>
    <!-- Hidden user ID carried over to submit -->
    <input id="bans-issue-user-id" type="hidden" value="" />
  </div>

  <label class="block text-sm">
    <span class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">{tr.console.bans_duration_label}</span>
    <select id="bans-issue-duration" class="w-full rounded border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-2 py-1.5 text-sm">
      <option value="1">{tr.console.bans_duration_1h}</option>
      <option value="24">{tr.console.bans_duration_24h}</option>
      <option value="168">{tr.console.bans_duration_7d}</option>
      <option value="720">{tr.console.bans_duration_30d}</option>
      <option value="">{tr.console.bans_duration_indefinite}</option>
    </select>
  </label>
</ConsoleSlideOver>

<script>
  import { getCachedSession, getSupabase } from '../lib/supabase';
  import { getUserRoles } from '../lib/user-roles';
  import { adminClient, AdminClientError } from '../lib/admin-client';
  import { readFilterState, writeFilterState } from '../lib/console-filter-state';

  type UserProfile = {
    id: string;
    username: string | null;
    display_name: string | null;
    avatar_url: string | null;
  };

  type BanRow = {
    id: string;
    user_id: string;
    banned_by: string | null;
    reason: string;
    expires_at: string | null;
    revoked_at: string | null;
    revoked_by: string | null;
    revoke_reason: string | null;
    created_at: string;
    user: UserProfile | null;
  };

  function show(id: string) { document.getElementById(id)?.classList.remove('hidden'); }
  function hide(id: string) { document.getElementById(id)?.classList.add('hidden'); }
  function escHtml(s: string): string {
    return s.replace(/[<>&'"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;',"'":'&#39;','"':'&quot;'}[c]!));
  }
  function fmtDate(iso: string): string {
    return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  function userLabel(b: BanRow): string {
    if (b.user?.display_name) return escHtml(b.user.display_name);
    if (b.user?.username) return escHtml('@' + b.user.username);
    return escHtml(b.user_id.slice(0, 8) + '…');
  }
  function userSub(b: BanRow): string {
    if (b.user?.username) return escHtml('@' + b.user.username);
    return escHtml(b.user_id.slice(0, 8) + '…');
  }

  let allBans: BanRow[] = [];
  let selectedId: string | null = null;
  let showActiveOnly = true;

  const supabase = getSupabase();

  async function init() {
    const session = await getCachedSession();
    if (!session?.user) { show('bans-not-auth'); return; }
    const myRoles = await getUserRoles(session.user.id);
    if (!myRoles.has('moderator') && !myRoles.has('admin')) { show('bans-not-auth'); return; }
    show('bans-shell');
    const saved = readFilterState();
    if (saved['filter'] === 'all') {
      showActiveOnly = false;
      document.getElementById('bans-toggle-all')!.className = 'px-3 py-1.5 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-medium';
      document.getElementById('bans-toggle-active')!.className = 'px-3 py-1.5 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300';
    }
    await loadBans();
  }

  async function loadBans() {
    hide('bans-list-empty');
    hide('bans-list');
    show('bans-list-loading');

    let query = supabase
      .from('user_bans')
      .select('*, user:users!user_id(id, username, display_name, avatar_url)')
      .order('created_at', { ascending: false })
      .limit(100);

    if (showActiveOnly) {
      query = query.is('revoked_at', null);
    }

    const { data, error } = await query;
    hide('bans-list-loading');

    if (error) {
      const e = document.getElementById('bans-error')!;
      e.textContent = error.message;
      show('bans-error');
      return;
    }

    allBans = (data ?? []) as unknown as BanRow[];
    if (allBans.length === 0) { show('bans-list-empty'); return; }
    renderList();
    show('bans-list');
  }

  function renderList() {
    const ul = document.getElementById('bans-list')!;
    ul.innerHTML = allBans.map(b => {
      const isSelected = b.id === selectedId ? 'bg-zinc-100 dark:bg-zinc-800/60' : '';
      const activeChip = !b.revoked_at
        ? `<span class="inline-block text-[9px] rounded bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-300 px-1 py-0.5">activa</span>`
        : `<span class="inline-block text-[9px] rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 px-1 py-0.5">levantada</span>`;
      const avatarHtml = b.user?.avatar_url
        ? `<img src="${escHtml(b.user.avatar_url)}" alt="" class="w-8 h-8 rounded-full object-cover flex-shrink-0" />`
        : `<div class="w-8 h-8 rounded-full bg-zinc-300 dark:bg-zinc-600 flex items-center justify-center text-sm font-bold text-zinc-500 dark:text-zinc-300 flex-shrink-0">${userLabel(b).slice(0,1).toUpperCase()}</div>`;
      return `<li data-ban-id="${escHtml(b.id)}" class="px-3 py-2 cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800/40 ${isSelected}">
        <div class="flex items-center gap-2">
          ${avatarHtml}
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1 mb-0.5">
              ${activeChip}
            </div>
            <div class="text-sm text-zinc-800 dark:text-zinc-200 truncate font-medium">${userLabel(b)}</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400 truncate">${userSub(b)}</div>
            <div class="text-xs text-zinc-400 truncate">${escHtml(b.reason.slice(0, 55))}</div>
          </div>
        </div>
      </li>`;
    }).join('');
  }

  function selectBan(id: string) {
    selectedId = id;
    const b = allBans.find(x => x.id === id);
    if (!b) return;
    renderList();

    hide('bans-detail-empty');
    show('bans-detail');

    const set = (elId: string, val: string) => {
      const el = document.getElementById(elId);
      if (el) el.textContent = val;
    };

    // User card
    const avatarEl = document.getElementById('bans-detail-avatar') as HTMLImageElement | null;
    const avatarPh = document.getElementById('bans-detail-avatar-placeholder');
    if (b.user?.avatar_url && avatarEl) {
      avatarEl.src = b.user.avatar_url;
      avatarEl.classList.remove('hidden');
      avatarPh?.classList.add('hidden');
    } else {
      avatarEl?.classList.add('hidden');
      if (avatarPh) {
        avatarPh.textContent = (b.user?.display_name || b.user?.username || '?').slice(0, 1).toUpperCase();
        avatarPh.classList.remove('hidden');
      }
    }
    set('bans-detail-display-name', b.user?.display_name || b.user?.username || '—');
    set('bans-detail-username', b.user?.username ? '@' + b.user.username : '');
    set('bans-detail-uid', b.user_id);

    set('bans-detail-reason', b.reason);
    set('bans-detail-expires', b.expires_at ? fmtDate(b.expires_at) : 'Indefinida');
    set('bans-detail-banned-by', b.banned_by ?? '—');
    set('bans-detail-created', fmtDate(b.created_at));

    const revokedRow = document.getElementById('bans-detail-revoked-row')!;
    const unbanBtn = document.getElementById('bans-action-unban')!;

    if (b.revoked_at) {
      set('bans-detail-revoked-at', fmtDate(b.revoked_at));
      if (b.revoke_reason) {
        set('bans-detail-revoke-reason', b.revoke_reason);
        show('bans-detail-revoke-reason-row');
      } else {
        hide('bans-detail-revoke-reason-row');
      }
      revokedRow.classList.remove('hidden');
      unbanBtn.classList.add('hidden');
    } else {
      revokedRow.classList.add('hidden');
      unbanBtn.classList.remove('hidden');
    }
  }

  async function refreshSelected() {
    if (!selectedId) return;
    await loadBans();
    const updated = allBans.find(x => x.id === selectedId);
    if (updated) selectBan(selectedId);
  }

  // User search for issue-ban form
  async function searchUserForBan(query: string) {
    const searchInput = query.trim();
    if (!searchInput) return;

    hide('bans-issue-user-preview');
    hide('bans-issue-not-found');
    (document.getElementById('bans-issue-user-id') as HTMLInputElement).value = '';

    let q = supabase
      .from('users')
      .select('id, username, display_name, avatar_url')
      .limit(1);

    if (searchInput.startsWith('@')) {
      q = q.ilike('username', searchInput.slice(1));
    } else if (/^[0-9a-f-]{36}$/i.test(searchInput)) {
      q = q.eq('id', searchInput);
    } else {
      // Try email via admin API, fall back to display_name search
      const session = await getCachedSession();
      if (session?.access_token) {
        try {
          const detail = await adminClient.user.detail({ email: searchInput }, '', session.access_token);
          // Load from users table using the returned id
          const { data } = await supabase.from('users').select('id, username, display_name, avatar_url').eq('id', detail.id).maybeSingle();
          if (data) {
            showFoundUser(data as UserProfile);
            return;
          }
        } catch {
          // fall through to display_name search
        }
      }
      q = q.ilike('display_name', `%${searchInput}%`);
    }

    const { data } = await q.maybeSingle();
    if (data) {
      showFoundUser(data as UserProfile);
    } else {
      show('bans-issue-not-found');
    }
  }

  function showFoundUser(u: UserProfile) {
    const avatarEl = document.getElementById('bans-issue-avatar') as HTMLImageElement | null;
    const avatarPh = document.getElementById('bans-issue-avatar-ph');
    if (u.avatar_url && avatarEl) {
      avatarEl.src = u.avatar_url;
      avatarEl.classList.remove('hidden');
      avatarPh?.classList.add('hidden');
    } else {
      avatarEl?.classList.add('hidden');
      if (avatarPh) {
        avatarPh.textContent = (u.display_name || u.username || '?').slice(0, 1).toUpperCase();
        avatarPh.classList.remove('hidden');
      }
    }
    const name = [u.display_name, u.username ? '@' + u.username : null].filter(Boolean).join(' · ');
    const foundName = document.getElementById('bans-issue-found-name');
    const foundUid = document.getElementById('bans-issue-found-uid');
    if (foundName) foundName.textContent = name || u.id;
    if (foundUid) foundUid.textContent = u.id;
    (document.getElementById('bans-issue-user-id') as HTMLInputElement).value = u.id;
    show('bans-issue-user-preview');
    hide('bans-issue-not-found');
  }

  // List click
  document.addEventListener('click', (ev) => {
    const li = (ev.target as HTMLElement).closest<HTMLElement>('li[data-ban-id]');
    if (li?.dataset.banId) { selectBan(li.dataset.banId); return; }

    if ((ev.target as HTMLElement).closest('#bans-action-unban') && selectedId) {
      const ban = allBans.find(x => x.id === selectedId);
      if (!ban) return;
      document.dispatchEvent(new CustomEvent('console:slideover-open', {
        detail: { id: 'console-slideover-bans', title: 'Levantar suspensión', action: 'user.unban', payload: { target_user_id: ban.user_id, ban_id: selectedId } },
      }));
      return;
    }

    if ((ev.target as HTMLElement).closest('#bans-toggle-active')) {
      showActiveOnly = true;
      document.getElementById('bans-toggle-active')!.className = 'px-3 py-1.5 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-medium';
      document.getElementById('bans-toggle-all')!.className = 'px-3 py-1.5 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300';
      writeFilterState({ filter: 'active' });
      loadBans();
      return;
    }

    if ((ev.target as HTMLElement).closest('#bans-toggle-all')) {
      showActiveOnly = false;
      document.getElementById('bans-toggle-all')!.className = 'px-3 py-1.5 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 font-medium';
      document.getElementById('bans-toggle-active')!.className = 'px-3 py-1.5 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300';
      writeFilterState({ filter: 'all' });
      loadBans();
      return;
    }

    if ((ev.target as HTMLElement).closest('#bans-open-issue')) {
      (document.getElementById('bans-issue-search') as HTMLInputElement).value = '';
      (document.getElementById('bans-issue-user-id') as HTMLInputElement).value = '';
      hide('bans-issue-user-preview');
      hide('bans-issue-not-found');
      document.dispatchEvent(new CustomEvent('console:slideover-open', {
        detail: {
          id: 'console-slideover-bans-issue',
          title: 'Suspender usuario',
          action: 'user.ban',
          payload: {},
        },
      }));
      return;
    }

    if ((ev.target as HTMLElement).closest('#bans-issue-search-btn')) {
      const val = (document.getElementById('bans-issue-search') as HTMLInputElement).value;
      searchUserForBan(val).catch(console.warn);
      return;
    }
  });

  // Search on Enter key
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter' && (ev.target as HTMLElement).id === 'bans-issue-search') {
      const val = (document.getElementById('bans-issue-search') as HTMLInputElement).value;
      searchUserForBan(val).catch(console.warn);
    }
  });

  // Issue ban + Unban via slide-over
  document.addEventListener('console:slideover-submit', async (ev) => {
    const { id, action, payload, reason } = (ev as CustomEvent<{ id: string; action: string; payload: Record<string, string>; reason: string }>).detail;

    if (id === 'console-slideover-bans-issue' && action === 'user.ban') {
      const userId = (document.getElementById('bans-issue-user-id') as HTMLInputElement).value.trim();
      const durationStr = (document.getElementById('bans-issue-duration') as HTMLSelectElement).value;

      if (!userId) {
        document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: false, error: 'Busca y selecciona un usuario primero.' } }));
        return;
      }

      const durationHours = durationStr ? parseInt(durationStr, 10) : null;

      const session = await getCachedSession();
      if (!session?.access_token) {
        document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: false, error: 'Sesión expirada.' } }));
        return;
      }

      try {
        try {
          await adminClient.user.ban({ target_user_id: userId, duration_hours: durationHours }, reason, session.access_token);
        } catch (edgeErr) {
          const { error: rpcErr } = await supabase.rpc('admin_ban_user', {
            p_target_user_id: userId,
            p_duration_hours: durationHours,
            p_reason: reason,
          });
          if (rpcErr) throw edgeErr;
        }
        document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: true } }));
        await loadBans();
      } catch (err) {
        const msg = err instanceof AdminClientError ? err.message : (err as Error).message;
        document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: false, error: msg } }));
      }
      return;
    }

    if (id !== 'console-slideover-bans') return;

    const session = await getCachedSession();
    if (!session?.access_token) {
      document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: false, error: 'Sesión expirada.' } }));
      return;
    }

    try {
      try {
        await adminClient.user.unban({ target_user_id: payload.target_user_id, ban_id: payload.ban_id }, reason, session.access_token);
      } catch (edgeErr) {
        const { error: rpcErr } = await supabase.rpc('admin_unban_user', {
          p_target_user_id: payload.target_user_id,
          p_ban_id: payload.ban_id,
          p_reason: reason,
        });
        if (rpcErr) throw edgeErr;
      }
      document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: true } }));
      await refreshSelected();
    } catch (err) {
      const msg = err instanceof AdminClientError ? err.message : (err as Error).message;
      document.dispatchEvent(new CustomEvent('console:slideover-done', { detail: { id, ok: false, error: msg } }));
    }
  });

  init().catch(err => {
    const e = document.getElementById('bans-error')!;
    e.textContent = (err as Error).message;
    show('bans-error');
  });
</script>
