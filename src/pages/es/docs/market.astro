---
import DocLayout from '../../../layouts/DocLayout.astro';
import { t } from '../../../i18n/utils';

const lang = 'es';
const tr = t(lang);

const matrix = [
  { feature: 'ID por foto',                  com: true,  inat: true,      merlin: true,      plantnet: true,      wi: false,     arbimon: false },
  { feature: 'ID por audio',                 com: true,  inat: 'partial', merlin: true,      plantnet: false,     wi: false,     arbimon: true  },
  { feature: 'Video',                        com: true,  inat: false,     merlin: false,     plantnet: false,     wi: false,     arbimon: false },
  { feature: 'Evidencia ecológica',          com: true,  inat: 'partial', merlin: false,     plantnet: false,     wi: false,     arbimon: false },
  { feature: 'Cámaras trampa',               com: true,  inat: false,     merlin: false,     plantnet: false,     wi: true,      arbimon: false },
  { feature: 'Sin conexión primero',         com: true,  inat: 'partial', merlin: 'partial', plantnet: 'partial', wi: false,     arbimon: false },
  { feature: 'Exportación a GBIF',           com: true,  inat: true,      merlin: false,     plantnet: 'partial', wi: true,      arbimon: false },
  { feature: 'CONABIO / CONANP',             com: true,  inat: false,     merlin: false,     plantnet: false,     wi: false,     arbimon: false },
  { feature: 'PITs / anclas QR',             com: true,  inat: false,     merlin: false,     plantnet: false,     wi: false,     arbimon: false },
  { feature: 'Gratis / código abierto',      com: true,  inat: true,      merlin: false,     plantnet: true,      wi: 'partial', arbimon: false },
];

function cellDisplay(v: boolean | string) {
  if (v === true)      return { text: '✓', cls: 'text-emerald-600 dark:text-emerald-400 font-bold' };
  if (v === 'partial') return { text: '~', cls: 'text-yellow-600 dark:text-yellow-400' };
  return                       { text: '✗', cls: 'text-zinc-600 dark:text-zinc-400' };
}
---

<DocLayout title={tr.docs.sections.market} lang={lang} section="market" editPath="src/pages/es/docs/market.astro">
  <article class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight mb-4">{tr.docs.sections.market}</h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl">{tr.docs.descriptions.market}</p>
    </div>

    <!-- Matriz competitiva -->
    <section>
      <h2 id="matriz-competitiva" class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-4">
        <a href="#matriz-competitiva" class="text-zinc-600 dark:text-zinc-400 hover:text-emerald-500 transition-colors">#</a> Matriz competitiva
      </h2>
      <div class="not-prose overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-zinc-200 dark:border-zinc-800">
              <th class="text-left py-2 px-3 text-zinc-600 dark:text-zinc-400 font-medium">Funcionalidad</th>
              <th class="py-2 px-3 text-emerald-600 dark:text-emerald-400 font-semibold">COM</th>
              <th class="py-2 px-3 text-zinc-600 dark:text-zinc-400 font-medium">iNaturalist</th>
              <th class="py-2 px-3 text-zinc-600 dark:text-zinc-400 font-medium">Merlin</th>
              <th class="py-2 px-3 text-zinc-600 dark:text-zinc-400 font-medium">PlantNet</th>
              <th class="py-2 px-3 text-zinc-600 dark:text-zinc-400 font-medium">Wildlife Insights</th>
              <th class="py-2 px-3 text-zinc-600 dark:text-zinc-400 font-medium">Arbimon</th>
            </tr>
          </thead>
          <tbody>
            {matrix.map((row, i) => (
              <tr class:list={["border-b border-zinc-100 dark:border-zinc-900", i % 2 === 0 ? "bg-zinc-50/50 dark:bg-zinc-950/50" : ""]}>
                <td class="py-2 px-3 text-zinc-700 dark:text-zinc-300">{row.feature}</td>
                {[row.com, row.inat, row.merlin, row.plantnet, row.wi, row.arbimon].map((v, j) => {
                  const c = cellDisplay(v);
                  return <td class:list={["py-2 px-3 text-center", c.cls, j === 0 ? "bg-emerald-500/5" : ""]}>{c.text}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">{'✓'}</span> soporte completo
          <span class="mx-2 text-zinc-400">|</span>
          <span class="text-yellow-600 dark:text-yellow-400">~</span> parcial
          <span class="mx-2 text-zinc-400">|</span>
          <span class="text-zinc-600 dark:text-zinc-300">{'✗'}</span> no soportado
        </p>
      </div>
    </section>
  </article>
</DocLayout>
