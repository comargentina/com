---
import DocLayout from '../../../layouts/DocLayout.astro';
import { t, getDocPath, docPages } from '../../../i18n/utils';

const lang = 'en';
const tr = t(lang);
const sections = tr.docs.sections as Record<string, string>;
const descriptions = tr.docs.descriptions as Record<string, string>;

const icons: Record<string, string> = {
  vision:       '🌿',
  features:     '⚡',
  roadmap:      '🗺️',
  tasks:        '✅',
  market:       '📊',
  architecture: '🏗️',
  indigenous:   '🦅',
  funding:      '💰',
  contribute:   '🤝',
  faq:          '❓',
  privacy:      '🔒',
  terms:        '📜',
};
---

<DocLayout title="Docs" lang={lang} section="" description="Documentation for COM Argentina: vision, architecture, roadmap, contributing, funding model, and FAQ.">
  <article class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight mb-2">{tr.docs.index_title}</h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl">{tr.docs.index_subtitle}</p>
    </div>

    <div class="not-prose flex flex-wrap gap-3">
      <a href={getDocPath(lang, 'roadmap')}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-800 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:border-emerald-500/40 hover:text-emerald-400 transition-colors">
        🗺️ Roadmap
      </a>
    </div>

    <!-- Section cards -->
    <div class="not-prose grid sm:grid-cols-2 gap-4">
      {docPages.map(page => (
        <a href={getDocPath(lang, page)}
          class="group p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/40 transition-all block">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xl">{icons[page] || '📄'}</span>
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {sections[page]}
            </h2>
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">{descriptions[page]}</p>
        </a>
      ))}
    </div>

    <!-- Current phase banner -->
    <div class="not-prose p-5 rounded-xl bg-emerald-500/5 border border-emerald-500/20">
      <div class="flex flex-wrap gap-4 items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-1">Current phase</p>
          <p class="text-zinc-700 dark:text-zinc-300 text-sm">v0.1 Alpha — Photo ID + Offline PWA + Zapoteco pilot</p>
        </div>
        <a href={getDocPath(lang, 'roadmap')}
          class="px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white text-sm font-medium transition-colors whitespace-nowrap">
          View roadmap →
        </a>
      </div>
    </div>
  </article>
</DocLayout>
